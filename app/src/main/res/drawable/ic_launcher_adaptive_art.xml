<?xml version="1.0" encoding="utf-8"?>
<!-- AdaptiveIconDrawable expands each layer to 108dp; inset the repaired source by 18dp
     per side so the woven mark remains within the 66dp safe zone on circular launchers. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_art"
    android:insetLeft="16.666667%"
    android:insetTop="16.666667%"
    android:insetRight="16.666667%"
    android:insetBottom="16.666667%" />

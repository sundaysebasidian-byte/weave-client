<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:layout_width="110dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_strand" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="@color/widget_dot_off" />

            <TextView
                android:id="@+id/widget_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/tile_label"
                android:textColor="@color/widget_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Longer words in other languages shrink to fit instead of being cut. -->
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="serif"
            android:gravity="center_vertical|start"
            android:letterSpacing="-0.015"
            android:maxLines="1"
            android:text="@string/tile_disconnected"
            android:textColor="@color/widget_ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_sub"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_power"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="14dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/action_connect"
        android:src="@drawable/ic_widget_power" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Keeps the optional scheduled subscription refresh across reboots (JobInfo.setPersisted). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <package android:name="com.github.kr328.clash" />
        <package android:name="com.github.kr328.clash.premium" />
        <package android:name="com.github.metacubex.clash" />
        <package android:name="com.github.metacubex.clash.meta" />
        <package android:name="com.github.metacubex.clash.alpha" />
        <package android:name="com.nebula.karing" />
        <package android:name="com.nebula.clashmi" />
        <package android:name="com.follow.clash" />
        <package android:name="com.follow.clash.dev" />
        <package android:name="com.v2ray.ang" />
        <package android:name="io.nekohasekai.sagernet" />
        <package android:name="io.nekohasekai.sfa" />
        <package android:name="moe.nb4a" />
        <package android:name="app.hiddify.com" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Weave"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Subscription links from browsers and other clients. Nothing is fetched until the
                 user confirms the import inside Weave. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clash" />
                <data android:scheme="clashmeta" />
                <data android:scheme="flclash" />
                <data android:scheme="sing-box" />
                <data android:scheme="hiddify" />
                <data android:scheme="weave" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The tunnel and native core run apart from the UI so a UI crash or reclaim does not
             drop the VPN. Both services below must stay in the same process. -->
        <service
            android:name=".core.vpn.WeaveVpnService"
            android:process=":vpn"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Routes user-selected network traffic through a local VPN tunnel." />
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <service
            android:name=".core.ipc.CoreControlService"
            android:process=":vpn"
            android:exported="false" />

        <service
            android:name=".core.vpn.WeaveTileService"
            android:process=":vpn"
            android:exported="true"
            android:icon="@drawable/ic_stat_weave"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".subscription.SubscriptionUpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>

<ContentControl x:Name="TransferPanel" Visibility="Collapsed" Style="{StaticResource GlassCard}"><StackPanel Spacing="18">
<TextBlock Text="{Binding DeviceSyncLabel, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}"/>
<TextBlock Text="{Binding ConnectYourPhoneAndPCToThe, Source={StaticResource UiText}}" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<Expander x:Name="ReceiveSection" Header="{Binding ReceiveFromPhone, Source={StaticResource UiText}}" IsExpanded="True" HorizontalAlignment="Stretch"><StackPanel Spacing="14">
<TextBox x:Name="ReceiveLink" Header="{Binding PasteTheWeaveLinkFromYourPhone, Source={StaticResource UiText}}" TextWrapping="Wrap"/><TextBox x:Name="ReceiveCode" Header="{Binding SenderSSixDigitCode, Source={StaticResource UiText}}" MaxLength="6"/>
<local:FlowPanel><Button Content="{Binding ReceiveAndPreview, Source={StaticResource UiText}}" Click="ReceiveLan_Click"/><Button Content="{Binding ReadQRImage, Source={StaticResource UiText}}" Click="QrFile_Click"/><Button Content="{Binding CameraScan, Source={StaticResource UiText}}" Click="CameraQr_Click"/></local:FlowPanel>
<StackPanel x:Name="ReceiveConfirmArea" Visibility="Collapsed" Spacing="12"><ListView x:Name="ReceivePreview" MaxHeight="200" SelectionMode="Multiple" DisplayMemberPath="Name"/>
<Button Content="{Binding ImportSelectedSubscriptions, Source={StaticResource UiText}}" Click="ConfirmTransfer_Click" HorizontalAlignment="Left"/></StackPanel>
</StackPanel></Expander>
<Expander x:Name="SendSection" Header="{Binding SendToPhoneLabel, Source={StaticResource UiText}}" HorizontalAlignment="Stretch"><StackPanel Spacing="14">
<ComboBox x:Name="LanAddress" Header="{Binding ThisDeviceSLANAddress, Source={StaticResource UiText}}"/><Button Content="{Binding RefreshAddresses, Source={StaticResource UiText}}" Click="RefreshAddresses_Click" HorizontalAlignment="Left"/>
<TextBlock Text="{Binding ToSendSelectSubscriptionsInYourLibrary, Source={StaticResource UiText}}" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<Image x:Name="ShareQr" Width="280" Height="280" HorizontalAlignment="Left" Visibility="Collapsed"/>
<TextBlock x:Name="ShareCode" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<TextBox x:Name="ShareLink" IsReadOnly="True" TextWrapping="Wrap" Header="{Binding OneTimeEncryptedLink, Source={StaticResource UiText}}"/>
<TextBlock x:Name="ShareStatus" Text="{Binding NotSharing, Source={StaticResource UiText}}" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<local:FlowPanel><Button Content="{Binding CopyLink, Source={StaticResource UiText}}" Click="CopyShareLink_Click"/><Button Content="{Binding StopSharing, Source={StaticResource UiText}}" Click="StopShare_Click"/></local:FlowPanel>
</StackPanel></Expander>
</StackPanel></ContentControl>
</StackPanel>
</ScrollViewer>
<Grid Grid.Row="2" Padding="32,8,32,16" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/>
<TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" MaxLines="3" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
</Grid></Grid></Grid></Window>

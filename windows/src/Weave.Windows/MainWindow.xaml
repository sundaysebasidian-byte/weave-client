                        </ListView>
<Expander Header="{Binding CustomDomainIPRules, Source={StaticResource UiText}}" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock Text="{Binding OneRulePerLineDOMAINSUFFIXExample, Source={StaticResource UiText}}" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/><TextBox x:Name="DomainRulesBox" AcceptsReturn="True" MinHeight="150" TextWrapping="Wrap" PlaceholderText="DOMAIN-SUFFIX,example.com,DIRECT"/><Button Content="{Binding ValidateAndSave, Source={StaticResource UiText}}" Click="ValidateRules_Click"/></StackPanel></Expander>
                    </StackPanel>

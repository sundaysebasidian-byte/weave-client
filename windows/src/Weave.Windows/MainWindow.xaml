<Window x:Class="Weave.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Weave">
<Grid x:Name="RootGrid" RequestedTheme="Light" Background="{ThemeResource WeaveCanvasBrush}" UseLayoutRounding="True" SizeChanged="RootGrid_SizeChanged">
<Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{ThemeResource WeaveCardBrush}" BorderBrush="{ThemeResource WeaveRimBrush}" BorderThickness="0,0,0.5,0">
<Grid Padding="16,30,16,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,38"><Image Source="ms-appx:///Assets/Weave.png" Width="42" Height="42" AutomationProperties.Name="Weave"/><StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="Weave" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/><TextBlock Text="WINDOWS" FontSize="9" CharacterSpacing="160" Foreground="{ThemeResource WeaveMutedBrush}"/></StackPanel></StackPanel>
<StackPanel Grid.Row="1" Spacing="5"><Button x:Name="Nav0" Tag="0" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,15"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE80F;" FontSize="18"/><TextBlock Text="连接" FontSize="14"/></StackPanel></Button>
<Button x:Name="Nav1" Tag="1" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,15"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE8F1;" FontSize="18"/><TextBlock Text="订阅" FontSize="14"/></StackPanel></Button>
<Button x:Name="Nav2" Tag="2" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,15"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE8AB;" FontSize="18"/><TextBlock Text="分流规则" FontSize="14"/></StackPanel></Button>
<Button x:Name="Nav4" Tag="4" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,15"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE774;" FontSize="18"/><TextBlock Text="网络与隐私" FontSize="14"/></StackPanel></Button>
<Button x:Name="Nav5" Tag="5" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,15"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE8AD;" FontSize="18"/><TextBlock Text="设备同步" FontSize="14"/></StackPanel></Button>
<Button x:Name="Nav3" Tag="3" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,15"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="&#xE713;" FontSize="18"/><TextBlock Text="设置" FontSize="14"/></StackPanel></Button></StackPanel>
<StackPanel Grid.Row="2" Spacing="7" Margin="12,0"><TextBlock Text="本地优先 · 无云端同步" FontSize="12" Foreground="{ThemeResource WeaveMutedBrush}"/><TextBlock Text="Windows 0.2 Preview" FontSize="10" Foreground="{ThemeResource WeaveMutedBrush}"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Padding="32,26,32,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Spacing="7"><TextBlock x:Name="PageTitle" Text="连接" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/><TextBlock x:Name="PageSubtitle" Visibility="Collapsed" FontSize="12" Foreground="{ThemeResource WeaveMutedBrush}"/></StackPanel>
<Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="18" Padding="14,9" Background="{ThemeResource WeaveCardBrush}"><TextBlock x:Name="StatusText" Text="未连接" FontSize="12" Foreground="{ThemeResource WeaveMutedBrush}"/></Border>
</Grid>
<ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="32,0,32,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsDeferredScrollingEnabled="False">
<StackPanel MaxWidth="1500" HorizontalAlignment="Stretch" Spacing="18">
<Grid x:Name="ConnectionPanel" ColumnSpacing="18" RowSpacing="18">
<Grid.ColumnDefinitions><ColumnDefinition x:Name="HeroColumn" Width="1.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="ConnectionHero" Grid.ColumnSpan="2" Style="{StaticResource GlassCard}" Padding="28" MinHeight="166">
<Grid ColumnSpacing="22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border Width="64" Height="64" CornerRadius="23" Background="{ThemeResource WeaveCardBrush}" VerticalAlignment="Center"><FontIcon Glyph="&#xE83D;" FontSize="30" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
<StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center"><TextBlock x:Name="HeroStatus" Text="尚未连接" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{ThemeResource WeaveMutedBrush}"/><TextBlock x:Name="HeroDetail" Text="选择订阅后连接" FontSize="12" Foreground="{ThemeResource WeaveMutedBrush}" TextWrapping="Wrap"/></StackPanel></StackPanel>
<Button x:Name="ConnectButton" Grid.Column="2" Content="连接" Click="ConnectButton_Click" VerticalAlignment="Center" MinWidth="138" Padding="26,16" FontWeight="SemiBold" Background="{ThemeResource WeaveAccentBrush}" Foreground="{ThemeResource WeaveCanvasBrush}"/>
</Grid></Border>
<Border x:Name="ExitCard" Grid.Row="1" Style="{StaticResource GlassCard}" Padding="26">
<StackPanel Spacing="20">
<TextBlock Text="出口节点" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<ComboBox x:Name="SubscriptionComboBox" Header="订阅" PlaceholderText="请选择订阅" DisplayMemberPath="Name" SelectionChanged="SubscriptionComboBox_SelectionChanged"/>
<Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ComboBox x:Name="NodeComboBox" Header="节点" PlaceholderText="自动选择 · 最低延迟" DisplayMemberPath="DisplayName"/>
<Button Grid.Column="1" Content="自动" Click="AutomaticNode_Click" VerticalAlignment="Bottom"/>
</Grid>
<Border BorderBrush="{ThemeResource WeaveRimBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="下载" FontSize="12" Foreground="{ThemeResource WeaveMutedBrush}"/><TextBlock x:Name="DownloadRate" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="上传" FontSize="12" Foreground="{ThemeResource WeaveMutedBrush}"/><TextBlock x:Name="UploadRate" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/></StackPanel></Grid></Border>
<Button Content="检查网络与隐私  →" Tag="4" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
</StackPanel></Border>
<Border x:Name="ConnectionNote" Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassCard}" Padding="26">
<StackPanel Spacing="18"><TextBlock Text="连接方式" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<ComboBox x:Name="RoutingSelector" Header="路由模式" SelectedIndex="0" SelectionChanged="RoutingMode_Changed"><x:String>规则</x:String><x:String>全局</x:String><x:String>直连</x:String></ComboBox>
<TextBlock x:Name="ModeExplanation" Text="按应用与域名规则分流，其余走默认出口。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<ToggleSwitch x:Name="TunToggle" Header="TUN 全设备接管" IsOn="True" OffContent="系统代理 · 仅支持代理的应用" OnContent="TUN · 需要管理员权限"/>
<Expander Header="链式代理" HorizontalAlignment="Stretch"><StackPanel Spacing="12">
<ToggleSwitch x:Name="ChainToggle" Header="入口 → 当前出口" OffContent="关闭" OnContent="开启"/>
<ComboBox x:Name="ChainSubscription" Header="入口订阅" DisplayMemberPath="Name" SelectionChanged="ChainSubscription_Changed"/>
<ComboBox x:Name="ChainNode" Header="入口节点" DisplayMemberPath="DisplayName"/>
<TextBlock Text="本机 → 入口 → 出口 → 网站。出口必须手动指定；单独指定出口的应用规则不走此默认链。UDP 能否使用取决于两端协议。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
</StackPanel></Expander>
<TextBlock Text="设置修改后重新连接生效。" FontSize="12" Foreground="{ThemeResource WeaveMutedBrush}"/>
</StackPanel></Border>
</Grid>
                <Border x:Name="RoutesPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="应用分流" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}" />
                        <TextBlock Text="按 Windows 进程名分流。添加或修改规则后，需要断开再连接才能应用。" Foreground="{ThemeResource WeaveMutedBrush}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProcessNameBox" Header="进程名" PlaceholderText="chrome.exe" />
                            <ComboBox x:Name="RouteSubscriptionComboBox" Grid.Column="1" Header="订阅" DisplayMemberPath="Name" SelectionChanged="RouteSubscriptionComboBox_SelectionChanged" />
                            <ComboBox x:Name="RouteTargetModeComboBox" Grid.Row="1" Header="出口类型" SelectionChanged="RouteTargetModeComboBox_SelectionChanged" />
                            <Button Grid.Row="1" Grid.Column="1" Content="保存规则" Click="AddRouteButton_Click" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                        </Grid>
                        <ComboBox x:Name="RouteNodeComboBox" Header="固定节点（仅固定节点时使用）" DisplayMemberPath="DisplayName" />
                        <ListView x:Name="RouteListView" MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProcessName}" Foreground="{ThemeResource WeaveInkBrush}" />
                                            <TextBlock Text="{Binding Target.Kind}" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="删除" Tag="{Binding ProcessName}" Click="DeleteRouteButton_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
<Expander Header="自订域名 / IP 规则" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock Text="每行一条：DOMAIN-SUFFIX,example.com,DIRECT。也可使用 PROXY 或 REJECT；支持 DOMAIN、IP-CIDR、IP-CIDR6。应用规则优先。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/><TextBox x:Name="DomainRulesBox" AcceptsReturn="True" MinHeight="150" TextWrapping="Wrap" PlaceholderText="DOMAIN-SUFFIX,example.com,DIRECT"/><Button Content="检查并保存规则" Click="ValidateRules_Click"/></StackPanel></Expander>
                    </StackPanel>
                </Border>

                <Border x:Name="ImportPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="导入订阅" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}" />
                        <TextBlock Text="本地导入内容使用 Windows DPAPI 加密保存；远程订阅只接受 HTTPS。" Foreground="{ThemeResource WeaveMutedBrush}" TextWrapping="Wrap" />
                        <TextBox x:Name="SubscriptionNameBox" Header="名称（可选）" PlaceholderText="例如：主订阅" />
                        <TextBox x:Name="SubscriptionUrlBox" Header="HTTPS 链接" PlaceholderText="https://example.com/sub" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="导入链接" Click="ImportUrlButton_Click" />
                            <Button Content="文件 / 其他客户端导出" Click="ImportFileButton_Click" /><Button Content="二维码图片" Click="QrFile_Click"/><Button Content="摄像头扫描" Click="CameraQr_Click"/>
                        </StackPanel>
                        <Expander Header="粘贴配置内容" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBox x:Name="SubscriptionTextBox" Header="或粘贴 Clash/Mihomo YAML / Base64" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                        <Button Content="导入粘贴内容" Click="ImportTextButton_Click" HorizontalAlignment="Left" /></StackPanel></Expander>
                    </StackPanel>
                </Border>

                <Border x:Name="SubscriptionsPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock Text="已导入订阅" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}" />
                        <TextBlock Text="选择订阅查看节点；可多选导出。导出的配置含连接凭据，请只分享给可信任的人。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="更新所选" Click="RefreshSubscription_Click"/><Button Content="编辑链接 / 名称" Click="EditSubscription_Click"/><Button Content="导出所选" Click="ExportSubscriptions_Click"/><Button Content="同步到手机" Click="ShareLan_Click"/></StackPanel>
                        <ListView x:Name="SubscriptionListView" SelectionMode="Multiple" SelectionChanged="SubscriptionListView_SelectionChanged" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{ThemeResource WeaveInkBrush}" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="删除" Tag="{Binding Id}" Click="DeleteSubscriptionButton_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource GlassCard}">
<StackPanel Spacing="18">
<TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<ComboBox x:Name="ThemeSelector" Header="外观 · 与 Android 相同的八套配色" SelectionChanged="ThemeSelector_SelectionChanged"/>
<ToggleSwitch x:Name="ChinaDirectToggle" Header="规则模式下：中国大陆直连" IsOn="True"/><TextBlock Text="离线规则库随安装包更新；应用规则与自订规则优先。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/><ToggleSwitch x:Name="Ipv6Toggle" Header="IPv6 双栈" IsOn="True"/>
<ComboBox x:Name="DnsSelector" Header="DNS"><x:String>加密 DNS</x:String><x:String>广告过滤</x:String><x:String>家庭过滤</x:String><x:String>自订 DNS</x:String></ComboBox>
<TextBox x:Name="CustomDnsBox" Header="自订加密 DNS" PlaceholderText="https://example.com/dns-query"/>
<ToggleSwitch x:Name="StunToggle" Header="阻止常见 STUN 端口" OffContent="关闭" OnContent="开启（可能影响通话）"/>
<TextBlock Text="网络设置在下次连接时生效。过滤依赖 DNS 服务，并非拦截所有广告。TUN 需要管理员权限。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<TextBlock Text="订阅由 Windows DPAPI 加密保存。加密 DNS 的首次解析使用明文引导 DNS；不宣称零泄漏。端口拦截不等于完整 WebRTC 防泄漏。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
</StackPanel></Border>
<Border x:Name="NodesPanel" Visibility="Collapsed" Style="{StaticResource GlassCard}"><StackPanel Spacing="14">
<Grid><TextBlock Text="订阅节点" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Content="测试当前订阅节点" Click="TestNodes_Click"/><Button Content="停止" Click="StopDiagnostics_Click"/></StackPanel></Grid>
<TextBlock Text="延迟测试需要先连接；只测试手动触发的订阅，不在后台循环测速。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<ListView x:Name="SubscriptionNodesList" Height="300" SelectionMode="Single" DisplayMemberPath="DisplayName" SelectionChanged="NodeList_SelectionChanged"/>
<TextBlock x:Name="NodeTestText" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
</StackPanel></Border>
<Border x:Name="DiagnosticsPanel" Visibility="Collapsed" Style="{StaticResource GlassCard}"><StackPanel Spacing="18">
<TextBlock Text="网络与隐私" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<TextBlock Text="一处检查出口 IP 与常用网站连通性。请求只经当前代理发送，失败不回落直连；结果不代表账号可登录或流媒体已解锁。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<CheckBox x:Name="DiagnosticConsent" Content="允许本次访问 ipify 及下方网站进行检测"/>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="开始检测" Click="RunDiagnostics_Click"/><Button Content="停止" Click="StopDiagnostics_Click"/></StackPanel>
<ListView x:Name="DiagnosticResults" MaxHeight="460" SelectionMode="None" DisplayMemberPath="Summary"/>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="WebRTC / 浏览器标识" Click="BrowserPrivacy_Click"/><Button Content="DNS 解析出口实测" Click="DnsPrivacy_Click"/></StackPanel>
<TextBlock Text="浏览器实验按需启动隔离的 WebView2；需额外允许访问测试服务。内置浏览器结果不代表 Chrome、其他应用或所有网络路径。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
</StackPanel></Border>

<Border x:Name="TransferPanel" Visibility="Collapsed" Style="{StaticResource GlassCard}"><StackPanel Spacing="18">
<TextBlock Text="设备间同步" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<TextBlock Text="手机与电脑连接同一 Wi-Fi、热点或 USB 共享网络。使用 Android 现有的 Weave 互传入口。仅同步你选择的订阅，不上传云端；链接和二维码含密钥，请勿公开。Windows 防火墙只需允许可信专用网络。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<ComboBox x:Name="LanAddress" Header="发送所用的本机局域网地址"/><Button Content="刷新网络地址" Click="RefreshAddresses_Click" HorizontalAlignment="Left"/>
<TextBlock Text="发送：先到订阅页勾选订阅，再点击“同步到手机”。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<Image x:Name="ShareQr" Width="280" Height="280" HorizontalAlignment="Left" Visibility="Collapsed"/>
<TextBlock x:Name="ShareCode" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<TextBox x:Name="ShareLink" IsReadOnly="True" TextWrapping="Wrap" Header="一次性加密链接"/>
<TextBlock x:Name="ShareStatus" Text="尚未开始分享" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="复制链接" Click="CopyShareLink_Click"/><Button Content="立即停止分享" Click="StopShare_Click"/></StackPanel>
<Border Height="1" Background="{ThemeResource WeaveRimBrush}"/>
<TextBlock Text="从手机接收" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<TextBox x:Name="ReceiveLink" Header="粘贴手机显示的 Weave 链接" TextWrapping="Wrap"/><TextBox x:Name="ReceiveCode" Header="发送端的六位核对码" MaxLength="6"/>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="接收并预览" Click="ReceiveLan_Click"/><Button Content="识别二维码图片" Click="QrFile_Click"/><Button Content="摄像头扫描" Click="CameraQr_Click"/></StackPanel>
<ListView x:Name="ReceivePreview" Height="180" SelectionMode="Multiple" DisplayMemberPath="Name"/>
<Button Content="确认导入勾选订阅" Click="ConfirmTransfer_Click" HorizontalAlignment="Left"/>
</StackPanel></Border>
</StackPanel>
</ScrollViewer>
<Grid Grid.Row="2" Padding="32,8,32,16" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/>
<TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" MaxLines="3" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
</Grid></Grid></Grid></Window>

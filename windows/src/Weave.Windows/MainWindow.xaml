<Window x:Class="Weave.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Weave">
<Grid x:Name="RootGrid" RequestedTheme="Light" Background="{ThemeResource WeaveCanvasBrush}" SizeChanged="RootGrid_SizeChanged">
<Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{ThemeResource WeaveCardBrush}" BorderBrush="{ThemeResource WeaveRimBrush}" BorderThickness="0,0,0.5,0">
<Grid Padding="16,28,16,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Spacing="12" Margin="10,0,0,34"><Image Source="ms-appx:///Assets/Weave.png" Width="44" Height="44" AutomationProperties.Name="Weave"/><StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="Weave" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/><TextBlock Text="PRIVATE NETWORK" FontSize="9" CharacterSpacing="120" Foreground="{ThemeResource WeaveMutedBrush}"/></StackPanel></StackPanel>
<StackPanel Grid.Row="1" Spacing="8"><Button x:Name="Nav0" Tag="0" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,14" AutomationProperties.Name="连接">
<StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE80F;" FontSize="19"/><TextBlock Text="连接" FontSize="14"/></StackPanel></Button>
<Button x:Name="Nav1" Tag="1" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,14" AutomationProperties.Name="订阅">
<StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8F1;" FontSize="19"/><TextBlock Text="订阅" FontSize="14"/></StackPanel></Button>
<Button x:Name="Nav2" Tag="2" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,14" AutomationProperties.Name="应用分流">
<StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8AB;" FontSize="19"/><TextBlock Text="应用分流" FontSize="14"/></StackPanel></Button>
<Button x:Name="Nav3" Tag="3" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,14" AutomationProperties.Name="设置">
<StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE713;" FontSize="19"/><TextBlock Text="设置" FontSize="14"/></StackPanel></Button></StackPanel>
<StackPanel Grid.Row="2" Spacing="10" Margin="12,0"><TextBlock Text="本地优先" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/><TextBlock Text="配置仅保存在此设备" FontSize="11" Foreground="{ThemeResource WeaveMutedBrush}"/><TextBlock Text="Windows · 测试版" FontSize="10" Foreground="{ThemeResource WeaveMutedBrush}"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Padding="32,28,32,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Spacing="7"><TextBlock x:Name="PageTitle" Text="连接" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/><TextBlock x:Name="PageSubtitle" Text="你的网络，从容掌握。" FontSize="13" Foreground="{ThemeResource WeaveMutedBrush}"/></StackPanel>
<Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="18" Padding="14,9" Background="{ThemeResource WeaveCardBrush}"><TextBlock x:Name="StatusText" Text="未连接" FontSize="12" Foreground="{ThemeResource WeaveMutedBrush}"/></Border>
</Grid>
<ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="32,0,32,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
<StackPanel MaxWidth="1160" HorizontalAlignment="Stretch" Spacing="20"><Grid x:Name="ConnectionPanel" ColumnSpacing="20" RowSpacing="20">
<Grid.ColumnDefinitions><ColumnDefinition x:Name="HeroColumn" Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="ConnectionHero" Style="{StaticResource GlassCard}" Padding="28" MinHeight="330">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Width="52" Height="52" HorizontalAlignment="Left" CornerRadius="18" Background="{ThemeResource WeaveCardBrush}"><FontIcon Glyph="&#xE83D;" FontSize="25" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
<StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12" Margin="0,28">
<TextBlock x:Name="HeroStatus" Text="尚未连接" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<TextBlock Text="选择出口，连接你的世界。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="14"/>
</StackPanel>
<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{ThemeResource WeaveMutedBrush}"/><TextBlock x:Name="HeroDetail" Text="本地内核 · 准备就绪后连接" FontSize="12" Foreground="{ThemeResource WeaveMutedBrush}"/></StackPanel>
</Grid></Border>
<Border x:Name="ExitCard" Grid.Column="1" Style="{StaticResource GlassCard}" Padding="28">
<StackPanel Spacing="18">
<TextBlock Text="选择出口" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<ComboBox x:Name="SubscriptionComboBox" Header="订阅" PlaceholderText="请选择订阅" DisplayMemberPath="Name" SelectionChanged="SubscriptionComboBox_SelectionChanged"/>
<Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ComboBox x:Name="NodeComboBox" Header="节点" PlaceholderText="自动选择 · 最低延迟" DisplayMemberPath="DisplayName"/>
<Button Grid.Column="1" Content="自动" Click="AutomaticNode_Click" VerticalAlignment="Bottom" ToolTipService.ToolTip="恢复当前订阅的自动选择"/>
</Grid>
<Button x:Name="ConnectButton" Content="连接" Click="ConnectButton_Click" HorizontalAlignment="Stretch" Margin="0,6,0,0" Padding="24,14" FontWeight="SemiBold" Background="{ThemeResource WeaveAccentBrush}" Foreground="{ThemeResource WeaveCanvasBrush}"/>
</StackPanel></Border>
<Border x:Name="ConnectionNote" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource GlassCard}">
<Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<FontIcon Glyph="&#xE713;" FontSize="22" Foreground="{ThemeResource WeaveAccentBrush}" VerticalAlignment="Top"/>
<StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="网络设置" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/><TextBlock Text="TUN 接管流量 · 支持 IPv4 / IPv6 · DNS 可选过滤" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="13"/><TextBlock Text="应用分流与 DNS 的修改在重新连接后生效。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="12"/></StackPanel>
<Button Grid.Column="2" Content="管理" Tag="3" Click="Navigate_Click" VerticalAlignment="Center"/>
</Grid></Border>
</Grid>
                <Border x:Name="RoutesPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="应用分流" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}" />
                        <TextBlock Text="按 Windows 进程名分流。添加或修改规则后，需要断开再连接才能应用。" Foreground="{ThemeResource WeaveMutedBrush}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProcessNameBox" Header="进程名" PlaceholderText="chrome.exe" />
                            <ComboBox x:Name="RouteSubscriptionComboBox" Grid.Column="1" Header="订阅" DisplayMemberPath="Name" SelectionChanged="RouteSubscriptionComboBox_SelectionChanged" />
                            <ComboBox x:Name="RouteTargetModeComboBox" Grid.Row="1" Header="出口类型" SelectionChanged="RouteTargetModeComboBox_SelectionChanged" />
                            <Button Grid.Row="1" Grid.Column="1" Content="保存规则" Click="AddRouteButton_Click" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                        </Grid>
                        <ComboBox x:Name="RouteNodeComboBox" Header="固定节点（仅固定节点时使用）" DisplayMemberPath="DisplayName" />
                        <ListView x:Name="RouteListView" MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProcessName}" Foreground="{ThemeResource WeaveInkBrush}" />
                                            <TextBlock Text="{Binding Target.Kind}" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="删除" Tag="{Binding ProcessName}" Click="DeleteRouteButton_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border x:Name="ImportPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="导入订阅" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}" />
                        <TextBlock Text="本地导入内容使用 Windows DPAPI 加密保存；远程订阅只接受 HTTPS。" Foreground="{ThemeResource WeaveMutedBrush}" TextWrapping="Wrap" />
                        <TextBox x:Name="SubscriptionNameBox" Header="名称（可选）" PlaceholderText="例如：主订阅" />
                        <TextBox x:Name="SubscriptionUrlBox" Header="HTTPS 链接" PlaceholderText="https://example.com/sub" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="导入链接" Click="ImportUrlButton_Click" />
                            <Button Content="选择 YAML 文件" Click="ImportFileButton_Click" />
                        </StackPanel>
                        <Expander Header="粘贴配置内容" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBox x:Name="SubscriptionTextBox" Header="或粘贴 Clash/Mihomo YAML / Base64" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                        <Button Content="导入粘贴内容" Click="ImportTextButton_Click" HorizontalAlignment="Left" /></StackPanel></Expander>
                    </StackPanel>
                </Border>

                <Border x:Name="SubscriptionsPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock Text="已导入订阅" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}" />
                        <ListView x:Name="SubscriptionListView" SelectionChanged="SubscriptionListView_SelectionChanged" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{ThemeResource WeaveInkBrush}" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="删除" Tag="{Binding Id}" Click="DeleteSubscriptionButton_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource GlassCard}">
<StackPanel Spacing="18">
<TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource WeaveInkBrush}"/>
<ComboBox x:Name="ThemeSelector" Header="外观" SelectionChanged="ThemeSelector_SelectionChanged"><x:String>浅色</x:String><x:String>白绿</x:String><x:String>深色</x:String></ComboBox>
<ToggleSwitch x:Name="Ipv6Toggle" Header="IPv6 双栈" IsOn="True"/>
<ComboBox x:Name="DnsSelector" Header="DNS"><x:String>加密 DNS</x:String><x:String>广告过滤</x:String><x:String>家庭过滤</x:String></ComboBox>
<TextBlock Text="网络设置在下次连接时生效。过滤依赖 DNS 服务，并非拦截所有广告。TUN 需要管理员权限。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
<TextBlock Text="订阅由 Windows DPAPI 加密保存。内核运行并不代表网站可达或泄漏检测通过。" TextWrapping="Wrap" Foreground="{ThemeResource WeaveMutedBrush}"/>
</StackPanel></Border>
<ListView x:Name="SubscriptionNodesList" Visibility="Collapsed" MaxHeight="300" SelectionMode="None" DisplayMemberPath="DisplayName"/>

</StackPanel>
</ScrollViewer>
<Grid Grid.Row="2" Padding="32,8,32,16" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/>
<TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" MaxLines="3" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
</Grid></Grid></Grid></Window>

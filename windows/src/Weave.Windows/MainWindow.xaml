<Window x:Class="Weave.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Weave.Windows"
    xmlns:core="using:Weave.Windows.Core"
    Title="Weave">
<Grid x:Name="RootGrid" RequestedTheme="Light" UseLayoutRounding="True">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked"/>
    </Grid.KeyboardAccelerators>

    <!-- Window size classes. AdaptiveTrigger switches only when the class changes, never per resize frame. -->
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="WindowSizeStates">
            <VisualState x:Name="WideLayout"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers></VisualState>
            <VisualState x:Name="CompactLayout"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters>
                <Setter Target="SidebarColumn.Width" Value="84"/>
                <Setter Target="NavLabel0.Visibility" Value="Collapsed"/>
                <Setter Target="NavLabel1.Visibility" Value="Collapsed"/>
                <Setter Target="NavLabel2.Visibility" Value="Collapsed"/>
                <Setter Target="NavLabel3.Visibility" Value="Collapsed"/>
                <Setter Target="NavLabel4.Visibility" Value="Collapsed"/>
                <Setter Target="NavLabel5.Visibility" Value="Collapsed"/>
                <Setter Target="SidebarFooter.Visibility" Value="Collapsed"/>
                <Setter Target="PageHeader.Padding" Value="16,16,16,8"/>
                <Setter Target="ApplyBar.Margin" Value="16,0,16,8"/>
                <Setter Target="ContentScroll.Padding" Value="16,8,16,24"/>
                <Setter Target="MessageBar.Margin" Value="16,0,16,16"/>
                <Setter Target="BusyBar.Margin" Value="16,0"/>
            </VisualState.Setters></VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- Backdrop layers. Mica shows through the translucent atmosphere veil; without Mica the canvas is opaque. -->
    <Rectangle x:Name="BackdropFallback" Grid.RowSpan="2" Fill="{ThemeResource WeaveCanvasBrush}" IsHitTestVisible="False"/>
    <Rectangle x:Name="AtmosphereVeil" Grid.RowSpan="2" Fill="{ThemeResource WeaveAtmosphereBrush}" IsHitTestVisible="False"/>
    <Viewbox x:Name="AtmosphericRibbons" Grid.RowSpan="2" Opacity="0.25" Stretch="Fill" IsHitTestVisible="False"><Canvas Width="1000" Height="800"><Canvas.Clip><RectangleGeometry Rect="0,0,1000,800"/></Canvas.Clip>
        <Path Fill="{ThemeResource WeaveRibbonBrush}" Data="M 280,0 C 660,140 400,290 750,490 C 850,548 930,540 1000,560 L 1000,800 C 750,720 550,460 510,350 C 435,150 630,95 280,0 Z"/>
        <Path Fill="{ThemeResource WeaveRibbonBrush}" Opacity="0.45" Data="M 0,610 C 160,420 350,565 410,380 C 448,262 480,95 770,0 L 1000,0 C 628,130 612,278 512,475 C 410,690 160,535 0,800 Z"/>
    </Canvas></Viewbox>

    <!-- Title bar: the whole row is the drag region; caption buttons are drawn by the system on the right. -->
    <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image Width="20" Height="20" AutomationProperties.AccessibilityView="Raw"><Image.Source><BitmapImage UriSource="ms-appx:///Assets/Weave.png" DecodePixelWidth="20" DecodePixelType="Logical"/></Image.Source></Image>
            <TextBlock Text="Weave" Style="{StaticResource BodyStrongText}"/>
        </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="SidebarSurface" Margin="12,0,0,12" CornerRadius="{StaticResource WeaveSurfaceRadius}" Background="{ThemeResource WeaveSidebarBrush}" BorderBrush="{ThemeResource WeaveLightEdgeBrush}" BorderThickness="1">
            <Grid Padding="12">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="SidebarNavigationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                    <StackPanel x:Name="NavigationItems" Spacing="4">
                        <RadioButton x:Name="Nav0" Tag="0" Style="{StaticResource WeaveNavItem}" IsChecked="True" Checked="Navigate_Checked" AccessKey="1" ToolTipService.ToolTip="{Binding Connect, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding Connect, Source={StaticResource UiText}}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE80F;" FontSize="18"/><TextBlock x:Name="NavLabel0" Grid.Column="1" Style="{StaticResource NavLabel}" Text="{Binding Connect, Source={StaticResource UiText}}"/></Grid>
                        </RadioButton>
                        <RadioButton x:Name="Nav1" Tag="1" Style="{StaticResource WeaveNavItem}" Checked="Navigate_Checked" AccessKey="2" ToolTipService.ToolTip="{Binding Subscriptions, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding Subscriptions, Source={StaticResource UiText}}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8F1;" FontSize="18"/><TextBlock x:Name="NavLabel1" Grid.Column="1" Style="{StaticResource NavLabel}" Text="{Binding Subscriptions, Source={StaticResource UiText}}"/></Grid>
                        </RadioButton>
                        <RadioButton x:Name="Nav2" Tag="2" Style="{StaticResource WeaveNavItem}" Checked="Navigate_Checked" AccessKey="3" ToolTipService.ToolTip="{Binding Routing, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding Routing, Source={StaticResource UiText}}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8AB;" FontSize="18"/><TextBlock x:Name="NavLabel2" Grid.Column="1" Style="{StaticResource NavLabel}" Text="{Binding Routing, Source={StaticResource UiText}}"/></Grid>
                        </RadioButton>
                        <RadioButton x:Name="Nav4" Tag="4" Style="{StaticResource WeaveNavItem}" Checked="Navigate_Checked" AccessKey="4" ToolTipService.ToolTip="{Binding NetworkPrivacy, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding NetworkPrivacy, Source={StaticResource UiText}}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE774;" FontSize="18"/><TextBlock x:Name="NavLabel4" Grid.Column="1" Style="{StaticResource NavLabel}" Text="{Binding NetworkPrivacy, Source={StaticResource UiText}}"/></Grid>
                        </RadioButton>
                        <RadioButton x:Name="Nav5" Tag="5" Style="{StaticResource WeaveNavItem}" Checked="Navigate_Checked" AccessKey="5" ToolTipService.ToolTip="{Binding DeviceSync, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding DeviceSync, Source={StaticResource UiText}}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8AD;" FontSize="18"/><TextBlock x:Name="NavLabel5" Grid.Column="1" Style="{StaticResource NavLabel}" Text="{Binding DeviceSync, Source={StaticResource UiText}}"/></Grid>
                        </RadioButton>
                        <RadioButton x:Name="Nav3" Tag="3" Style="{StaticResource WeaveNavItem}" Checked="Navigate_Checked" AccessKey="6" ToolTipService.ToolTip="{Binding Settings, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding Settings, Source={StaticResource UiText}}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE713;" FontSize="18"/><TextBlock x:Name="NavLabel3" Grid.Column="1" Style="{StaticResource NavLabel}" Text="{Binding Settings, Source={StaticResource UiText}}"/></Grid>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="SidebarFooter" Grid.Row="1" Visibility="Collapsed" Margin="4,8,4,4" Padding="0,12,0,0" ColumnSpacing="16" BorderBrush="{ThemeResource WeaveRimBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74B;" FontSize="12" Foreground="{ThemeResource WeaveAccentBrush}"/><TextBlock Text="{Binding Download, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/></StackPanel>
                        <TextBlock x:Name="DownloadRate" Text="—" Style="{StaticResource BodyStrongText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74A;" FontSize="12" Foreground="{ThemeResource WeaveAccentBrush}"/><TextBlock Text="{Binding Upload, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/></StackPanel>
                        <TextBlock x:Name="UploadRate" Text="—" Style="{StaticResource BodyStrongText}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid x:Name="PageHeader" Padding="32,16,32,8" ColumnSpacing="16" MaxWidth="1024">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PageTitle" Style="{StaticResource TitleText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Connect, Source={StaticResource UiText}}" AutomationProperties.HeadingLevel="Level1"/>
                <Border x:Name="StatusPill" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center" CornerRadius="16" Padding="12,6" BorderThickness="1" BorderBrush="{ThemeResource WeaveLightEdgeBrush}" Background="{ThemeResource WeaveGlassBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource WeaveMutedBrush}"/>
                        <TextBlock x:Name="StatusText" MaxWidth="280" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionText}" Text="{Binding Disconnected, Source={StaticResource UiText}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- One-click apply for pending changes while connected; shown on every page. -->
            <InfoBar x:Name="ApplyBar" Grid.Row="1" Margin="32,0,32,8" MaxWidth="960" Severity="Informational" IsOpen="False" IsClosable="True" Message="{Binding ReconnectToApplyChanges, Source={StaticResource UiText}}">
                <InfoBar.ActionButton><Button Content="{Binding ReconnectNetwork, Source={StaticResource UiText}}" Click="ReconnectNetwork_Click" HorizontalAlignment="Right"/></InfoBar.ActionButton>
            </InfoBar>

            <ScrollViewer x:Name="ContentScroll" Grid.Row="2" Padding="32,8,32,32" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsDeferredScrollingEnabled="False">
                <StackPanel x:Name="PageStack" MaxWidth="960" HorizontalAlignment="Stretch" Spacing="16">

                    <!-- Connect -->
                    <ContentControl x:Name="ConnectionHero" Style="{StaticResource GlassCard}" Background="{ThemeResource WeaveHeroBrush}" MinHeight="112">
                        <local:ResponsiveGrid ColumnSpacing="24" RowSpacing="16" MinColumnWidth="240">
                            <Grid ColumnSpacing="16" local:ResponsiveGrid.Weight="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Width="64" Height="64" VerticalAlignment="Center">
                                    <Ellipse Fill="{ThemeResource WeaveIconBrush}" Stroke="{ThemeResource WeaveLightEdgeBrush}" StrokeThickness="1"/>
                                    <Ellipse Margin="4" Stroke="{ThemeResource WeaveInnerEdgeBrush}" StrokeThickness="1"/>
                                    <Viewbox Width="26" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="31">
                                        <Path x:Name="HeroShield" Stroke="{ThemeResource WeaveAccentBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M 12,2 C 15,4 19,5 22,5 L 22,15 C 22,21 18,26 12,29 C 6,26 2,21 2,15 L 2,5 C 5,5 9,4 12,2 Z"/>
                                        <Path x:Name="HeroCheck" Visibility="Collapsed" Stroke="{ThemeResource WeaveSuccessBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,15 L 11,19 L 18,11"/>
                                    </Canvas></Viewbox>
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroStatus" Style="{StaticResource TitleText}" TextWrapping="Wrap" Text="{Binding ReadyToConnect, Source={StaticResource UiText}}"/>
                                    <StackPanel x:Name="HeroDetailRow" Orientation="Horizontal" Spacing="8">
                                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource WeaveMutedBrush}"/>
                                        <TextBlock x:Name="HeroDetail" Style="{StaticResource SecondaryText}" Text="{Binding ChooseASubscriptionToGetStarted, Source={StaticResource UiText}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="ConnectButton" local:ResponsiveGrid.Weight="0" Style="{StaticResource AccentButtonStyle}" Content="{Binding Connect, Source={StaticResource UiText}}" Click="ConnectButton_Click" AccessKey="C" VerticalAlignment="Center" MinWidth="144" MinHeight="48" Padding="24,12" CornerRadius="12" FontWeight="SemiBold">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control"/></Button.KeyboardAccelerators>
                                <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7E8;" FontSize="16"/><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding}"/></StackPanel></DataTemplate></Button.ContentTemplate>
                            </Button>
                        </local:ResponsiveGrid>
                    </ContentControl>

                    <ContentControl x:Name="ExitCard" Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <TextBlock Grid.Column="1" Text="{Binding ExitNode, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <Button x:Name="ManageSubscriptionsButton" Grid.Column="2" Tag="1" Click="Navigate_Click" Background="Transparent" BorderThickness="0" Padding="12,4" MinHeight="32" VerticalAlignment="Center" Foreground="{ThemeResource WeaveMutedBrush}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding ManageSubscriptions, Source={StaticResource UiText}}"/><FontIcon Glyph="&#xE76C;" FontSize="10"/></StackPanel></Button>
                            </Grid>
                            <local:ResponsiveGrid x:Name="ExitSelectors" ColumnSpacing="16" RowSpacing="16" MinColumnWidth="240">
                                <ComboBox x:Name="SubscriptionComboBox" local:ResponsiveGrid.Weight="1" Header="{Binding Subscriptions, Source={StaticResource UiText}}" PlaceholderText="{Binding SelectASubscription, Source={StaticResource UiText}}" DisplayMemberPath="Name" SelectionChanged="SubscriptionComboBox_SelectionChanged"/>
                                <Grid x:Name="NodeSelection" local:ResponsiveGrid.Weight="1.3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="NodeComboBox" Header="{Binding Node, Source={StaticResource UiText}}" PlaceholderText="{Binding AutomaticLowestLatency, Source={StaticResource UiText}}" DisplayMemberPath="DisplayName" SelectionChanged="DefaultNode_Changed"/>
                                    <Button x:Name="AutomaticNodeButton" Grid.Column="1" Content="{Binding Auto, Source={StaticResource UiText}}" Click="AutomaticNode_Click" VerticalAlignment="Bottom"/>
                                </Grid>
                            </local:ResponsiveGrid>
                            <Grid x:Name="ExitEmptyState" Visibility="Collapsed" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ImportASubscriptionFirst, Source={StaticResource UiText}}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Tag="1" Click="Navigate_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding ImportSubscription, Source={StaticResource UiText}}"/></StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl x:Name="ConnectionNote" Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE968;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <TextBlock Grid.Column="1" Text="{Binding NetworkSettings, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Tag="3" Click="Navigate_Click" Background="Transparent" BorderThickness="0" Padding="12,4" MinHeight="32" VerticalAlignment="Center" Foreground="{ThemeResource WeaveMutedBrush}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding Settings, Source={StaticResource UiText}}"/><FontIcon Glyph="&#xE76C;" FontSize="10"/></StackPanel></Button>
                            </Grid>
                            <local:ResponsiveGrid x:Name="NetworkOptions" ColumnSpacing="24" RowSpacing="16" MinColumnWidth="240">
                                <ComboBox x:Name="RoutingSelector" local:ResponsiveGrid.Weight="1" Header="{Binding RoutingMode, Source={StaticResource UiText}}" SelectedIndex="0" SelectionChanged="RoutingMode_Changed"/>
                                <ToggleSwitch x:Name="TunToggle" local:ResponsiveGrid.Weight="1.3" VerticalAlignment="Center" Header="{Binding TUNDeviceWideRouting, Source={StaticResource UiText}}" IsOn="True" OffContent="{Binding SystemProxyCompatibleAppsOnly, Source={StaticResource UiText}}" OnContent="{Binding TUNManagedByCoreService, Source={StaticResource UiText}}" Toggled="Setting_Changed"/>
                            </local:ResponsiveGrid>
                            <TextBlock x:Name="ModeExplanation" Style="{StaticResource CaptionText}" Text="{Binding RouteByAppAndDomainUseThe, Source={StaticResource UiText}}"/>
                            <local:FlowPanel>
                                <Button Click="RecheckNetwork_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding RecheckNetwork, Source={StaticResource UiText}}"/></StackPanel></Button>
                                <Button Click="ReconnectNetwork_Click"><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding ReconnectNetwork, Source={StaticResource UiText}}"/></Button>
                            </local:FlowPanel>
                            <Expander Header="{Binding ProxyChain, Source={StaticResource UiText}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="16">
                                <Grid ColumnSpacing="16" MinHeight="44">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EntryCurrentExit, Source={StaticResource UiText}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ChainToggle" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" AutomationProperties.Name="{Binding EntryCurrentExit, Source={StaticResource UiText}}"
                                        OnContent="{Binding On, Source={StaticResource UiText}}" OffContent="{Binding Off, Source={StaticResource UiText}}" Toggled="Setting_Changed"/>
                                </Grid>
                                <local:ResponsiveGrid ColumnSpacing="16" RowSpacing="16" MinColumnWidth="200">
                                    <ComboBox x:Name="ChainSubscription" Header="{Binding EntrySubscription, Source={StaticResource UiText}}" PlaceholderText="{Binding SelectASubscription, Source={StaticResource UiText}}" DisplayMemberPath="Name" SelectionChanged="ChainSubscription_Changed"/>
                                    <ComboBox x:Name="ChainNode" Header="{Binding EntryNode, Source={StaticResource UiText}}" DisplayMemberPath="DisplayName" SelectionChanged="Setting_Changed"/>
                                </local:ResponsiveGrid>
                                <TextBlock Text="{Binding DeviceEntryExitWebsiteSelectTheExit, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}"/>
                            </StackPanel></Expander>
                        </StackPanel>
                    </ContentControl>

                    <!-- Routing -->
                    <ContentControl x:Name="RoutesPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE8AB;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding AppRouting, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Style="{StaticResource InfoButton}" Content="&#xE946;" ToolTipService.ToolTip="{Binding RouteByWindowsProcessNameReconnectAfter, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding RouteByWindowsProcessNameReconnectAfter, Source={StaticResource UiText}}"/></StackPanel>
                            </Grid>
                            <local:ResponsiveGrid ColumnSpacing="16" RowSpacing="16" MinColumnWidth="240">
                                <TextBox x:Name="ProcessNameBox" Header="{Binding ProcessName, Source={StaticResource UiText}}" PlaceholderText="chrome.exe" KeyDown="ProcessNameBox_KeyDown"/>
                                <ComboBox x:Name="RouteTargetModeComboBox" Header="{Binding ExitType, Source={StaticResource UiText}}" SelectionChanged="RouteTargetModeComboBox_SelectionChanged"/>
                            </local:ResponsiveGrid>
                            <local:ResponsiveGrid ColumnSpacing="16" RowSpacing="16" MinColumnWidth="240">
                                <ComboBox x:Name="RouteSubscriptionComboBox" Header="{Binding Subscriptions, Source={StaticResource UiText}}" PlaceholderText="{Binding SelectASubscription, Source={StaticResource UiText}}" DisplayMemberPath="Name" SelectionChanged="RouteSubscriptionComboBox_SelectionChanged"/>
                                <ComboBox x:Name="RouteNodeComboBox" Header="{Binding NodeSpecificNodeRoutingOnly, Source={StaticResource UiText}}" DisplayMemberPath="DisplayName"/>
                            </local:ResponsiveGrid>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="AddRouteButton_Click" HorizontalAlignment="Right"><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding SaveRule, Source={StaticResource UiText}}"/></Button>
                            <ListView x:Name="RouteListView" Visibility="Collapsed" MaxHeight="320" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:WindowsAppRoute">
                                        <Grid ColumnSpacing="12" Padding="0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ProcessName}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind TargetLabel, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{x:Bind ProcessName}" Click="DeleteRouteButton_Click" Background="Transparent" BorderThickness="0" Padding="8" MinWidth="32" MinHeight="32" ToolTipService.ToolTip="{Binding Delete, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding Delete, Source={StaticResource UiText}}"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Expander Header="{Binding CustomDomainIPRules, Source={StaticResource UiText}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="16">
                                <TextBlock Text="{Binding OneRulePerLineDOMAINSUFFIXExample, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}"/>
                                <TextBox x:Name="DomainRulesBox" AcceptsReturn="True" MinHeight="152" TextWrapping="Wrap" PlaceholderText="DOMAIN-SUFFIX,example.com,DIRECT"/>
                                <Button Content="{Binding ValidateAndSave, Source={StaticResource UiText}}" Click="ValidateRules_Click"/>
                            </StackPanel></Expander>
                        </StackPanel>
                    </ContentControl>

                    <!-- Subscriptions -->
                    <ContentControl x:Name="ImportPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding ImportSubscription, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Style="{StaticResource InfoButton}" Content="&#xE946;" ToolTipService.ToolTip="{Binding ImportedContentIsEncryptedWithWindowsDPAPI, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding ImportedContentIsEncryptedWithWindowsDPAPI, Source={StaticResource UiText}}"/></StackPanel>
                            </Grid>
                            <local:ResponsiveGrid ColumnSpacing="16" RowSpacing="16" MinColumnWidth="240">
                                <TextBox x:Name="SubscriptionUrlBox" local:ResponsiveGrid.Weight="1.6" Header="{Binding HTTPSURL, Source={StaticResource UiText}}" PlaceholderText="https://example.com/sub" KeyDown="SubscriptionUrlBox_KeyDown"/>
                                <TextBox x:Name="SubscriptionNameBox" local:ResponsiveGrid.Weight="1" Header="{Binding NameOptional, Source={StaticResource UiText}}" PlaceholderText="{Binding EGMainSubscription, Source={StaticResource UiText}}"/>
                            </local:ResponsiveGrid>
                            <local:FlowPanel>
                                <Button Style="{StaticResource AccentButtonStyle}" Click="ImportUrlButton_Click"><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding ImportLink, Source={StaticResource UiText}}"/></Button>
                                <Button Content="{Binding FileClientExport, Source={StaticResource UiText}}" Click="ImportFileButton_Click"/>
                                <Button Content="{Binding QRImage, Source={StaticResource UiText}}" Click="QrFile_Click"/>
                                <Button Content="{Binding CameraScan, Source={StaticResource UiText}}" Click="CameraQr_Click"/>
                            </local:FlowPanel>
                            <Expander Header="{Binding PasteConfiguration, Source={StaticResource UiText}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="16">
                                <TextBox x:Name="SubscriptionTextBox" Header="{Binding ClashMihomoYAMLBase64, Source={StaticResource UiText}}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"/>
                                <Button Content="{Binding ImportText, Source={StaticResource UiText}}" Click="ImportTextButton_Click" HorizontalAlignment="Left"/>
                            </StackPanel></Expander>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl x:Name="SubscriptionsPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding YourLibrary, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Style="{StaticResource InfoButton}" Content="&#xE946;" ToolTipService.ToolTip="{Binding SelectASubscriptionToViewItsNodes, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding SelectASubscriptionToViewItsNodes, Source={StaticResource UiText}}"/></StackPanel>
                            </Grid>
                            <local:FlowPanel>
                                <Button Click="RefreshSubscription_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding Refresh, Source={StaticResource UiText}}"/></StackPanel></Button>
                                <Button Click="EditSubscription_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="14"/><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding Edit, Source={StaticResource UiText}}"/></StackPanel></Button>
                                <Button Click="ExportSubscriptions_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="14"/><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding Export, Source={StaticResource UiText}}"/></StackPanel></Button>
                                <Button Click="ShareLan_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE724;" FontSize="14"/><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding SendToPhone, Source={StaticResource UiText}}"/></StackPanel></Button>
                            </local:FlowPanel>
                            <ListView x:Name="SubscriptionListView" SelectionMode="Multiple" SelectionChanged="SubscriptionListView_SelectionChanged" MaxHeight="280">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:SubscriptionRecord">
                                        <Grid ColumnSpacing="12" Padding="0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{x:Bind Id}" Click="DeleteSubscriptionButton_Click" Background="Transparent" BorderThickness="0" Padding="8" MinWidth="32" MinHeight="32" ToolTipService.ToolTip="{Binding Delete, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding Delete, Source={StaticResource UiText}}"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl x:Name="NodesPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding SubscriptionNodes, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Style="{StaticResource InfoButton}" Content="&#xE946;" ToolTipService.ToolTip="{Binding ConnectBeforeTestingLatencyTestsRunOnly, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding ConnectBeforeTestingLatencyTestsRunOnly, Source={StaticResource UiText}}"/></StackPanel>
                            </Grid>
                            <local:FlowPanel>
                                <Button Style="{StaticResource AccentButtonStyle}" Click="TestNodes_Click"><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding TestNodes, Source={StaticResource UiText}}"/></Button>
                                <Button Content="{Binding Stop, Source={StaticResource UiText}}" Click="StopDiagnostics_Click"/>
                            </local:FlowPanel>
                            <ListView x:Name="SubscriptionNodesList" MaxHeight="360" SelectionMode="Single" SelectionChanged="NodeList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:NodeRow">
                                        <Grid ColumnSpacing="12" MinHeight="40">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Phase="1" Text="{x:Bind Protocol}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" x:Phase="1" Text="{x:Bind DelayText, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="NodeTestText" Visibility="Collapsed" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </ContentControl>

                    <!-- Settings -->
                    <ContentControl x:Name="SettingsPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <TextBlock Grid.Column="1" Text="{Binding Personalization, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </Grid>
                            <local:ResponsiveGrid ColumnSpacing="24" RowSpacing="16" MinColumnWidth="240">
                                <ComboBox x:Name="ThemeSelector" local:ResponsiveGrid.Weight="1.4" Header="{Binding Appearance, Source={StaticResource UiText}}" SelectionChanged="ThemeSelector_SelectionChanged"/>
                                <ComboBox x:Name="LanguageSelector" local:ResponsiveGrid.Weight="1" Header="{Binding Language, Source={StaticResource UiText}}" SelectionChanged="LanguageSelector_SelectionChanged"><x:String>简体中文</x:String><x:String>English</x:String></ComboBox>
                            </local:ResponsiveGrid>
                            <TextBlock Text="{Binding TrayCloseNotice, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl x:Name="NetworkSettingsCard" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE968;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <TextBlock Grid.Column="1" Text="{Binding NetworkSettings, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="16" MinHeight="44">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BypassMainlandChinaInRuleMode, Source={StaticResource UiText}}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OfflineRulesUpdateWithTheAppApp, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ChinaDirectToggle" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" AutomationProperties.Name="{Binding BypassMainlandChinaInRuleMode, Source={StaticResource UiText}}" IsOn="True"
                                    OnContent="{Binding On, Source={StaticResource UiText}}" OffContent="{Binding Off, Source={StaticResource UiText}}" Toggled="Setting_Changed"/>
                            </Grid>
                            <Grid ColumnSpacing="16" MinHeight="44">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IPv6DualStack, Source={StaticResource UiText}}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="Ipv6Toggle" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" AutomationProperties.Name="{Binding IPv6DualStack, Source={StaticResource UiText}}" IsOn="True"
                                    OnContent="{Binding On, Source={StaticResource UiText}}" OffContent="{Binding Off, Source={StaticResource UiText}}" Toggled="Setting_Changed"/>
                            </Grid>
                            <local:ResponsiveGrid ColumnSpacing="16" RowSpacing="16" MinColumnWidth="240">
                                <ComboBox x:Name="DnsSelector" Header="DNS" SelectionChanged="Setting_Changed"/>
                                <TextBox x:Name="CustomDnsBox" Header="{Binding CustomEncryptedDNS, Source={StaticResource UiText}}" PlaceholderText="https://example.com/dns-query" TextChanged="CustomDnsBox_TextChanged"/>
                            </local:ResponsiveGrid>
                            <Grid ColumnSpacing="16" MinHeight="44">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BlockCommonSTUNPorts, Source={StaticResource UiText}}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="StunToggle" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" AutomationProperties.Name="{Binding BlockCommonSTUNPorts, Source={StaticResource UiText}}"
                                    OnContent="{Binding OnMayAffectCalls, Source={StaticResource UiText}}" OffContent="{Binding Off, Source={StaticResource UiText}}" Toggled="Setting_Changed"/>
                            </Grid>
                            <TextBlock Text="{Binding NetworkSettingsApplyOnTheNextConnection, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl x:Name="PrivacySettingsCard" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <TextBlock Grid.Column="1" Text="{Binding PrivacyBoundaries, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding SubscriptionsAreEncryptedWithWindowsDPAPIEncrypted, Source={StaticResource UiText}}" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </ContentControl>

                    <!-- Network and privacy -->
                    <ContentControl x:Name="DiagnosticsPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding NetworkPrivacy, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Style="{StaticResource InfoButton}" Content="&#xE946;" ToolTipService.ToolTip="{Binding CheckYourExitIPAndPopularWebsites, Source={StaticResource UiText}}" AutomationProperties.Name="{Binding CheckYourExitIPAndPopularWebsites, Source={StaticResource UiText}}"/></StackPanel>
                            </Grid>
                            <CheckBox x:Name="DiagnosticConsent" Content="{Binding AllowThisTestToContactIpifyAnd, Source={StaticResource UiText}}"/>
                            <local:FlowPanel>
                                <Button Style="{StaticResource AccentButtonStyle}" Click="RunDiagnostics_Click"><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding RunTests, Source={StaticResource UiText}}"/></Button>
                                <Button Content="{Binding Stop, Source={StaticResource UiText}}" Click="StopDiagnostics_Click"/>
                                <Button Content="{Binding PreviewSafeSummary, Source={StaticResource UiText}}" Click="PreviewDiagnostics_Click"/>
                            </local:FlowPanel>
                            <TextBlock x:Name="DiagnosticEvidenceText" Visibility="Collapsed" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="DiagnosticProgress" Visibility="Collapsed" Style="{StaticResource CaptionText}"/>
                            <ListView x:Name="DiagnosticResults" MaxHeight="480" SelectionMode="None">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:ProbeResult">
                                        <Border Background="{ThemeResource WeaveGlassBrush}" BorderBrush="{ThemeResource WeaveLightEdgeBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" MinHeight="72">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4"><TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" Style="{StaticResource BodyStrongText}"/><TextBlock Text="{x:Bind Details, Mode=OneWay}" Style="{StaticResource SecondaryText}"/></StackPanel>
                                                <Border Grid.Column="1" VerticalAlignment="Top" Background="{ThemeResource WeaveSelectionBrush}" CornerRadius="8" Padding="8,4"><TextBlock Text="{x:Bind EvidenceLabel, Mode=OneWay}" FontSize="12" TextWrapping="NoWrap"/></Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <local:FlowPanel>
                                <Button Content="{Binding WebRTCFingerprint, Source={StaticResource UiText}}" Click="BrowserPrivacy_Click"/>
                                <Button Content="{Binding DNSResolverTest, Source={StaticResource UiText}}" Click="DnsPrivacy_Click"/>
                            </local:FlowPanel>
                            <TextBlock Text="{Binding TheBrowserLabOpensAnIsolatedWebView2, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </ContentControl>

                    <!-- Device sync -->
                    <ContentControl x:Name="TransferPanel" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE8AD;" FontSize="16" Foreground="{ThemeResource WeaveAccentBrush}"/></Border>
                                <TextBlock Grid.Column="1" Text="{Binding DeviceSyncLabel, Source={StaticResource UiText}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding ConnectYourPhoneAndPCToThe, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}"/>
                            <Expander x:Name="ReceiveSection" Header="{Binding ReceiveFromPhone, Source={StaticResource UiText}}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="16">
                                <TextBox x:Name="ReceiveLink" Header="{Binding PasteTheWeaveLinkFromYourPhone, Source={StaticResource UiText}}" TextWrapping="Wrap"/>
                                <TextBox x:Name="ReceiveCode" Header="{Binding SenderSSixDigitCode, Source={StaticResource UiText}}" MaxLength="6" KeyDown="ReceiveCode_KeyDown"/>
                                <local:FlowPanel>
                                    <Button x:Name="ReceiveButton" Style="{StaticResource AccentButtonStyle}" Click="ReceiveLan_Click"><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding ReceiveAndPreview, Source={StaticResource UiText}}"/></Button>
                                    <Button Content="{Binding ReadQRImage, Source={StaticResource UiText}}" Click="QrFile_Click"/>
                                    <Button Content="{Binding CameraScan, Source={StaticResource UiText}}" Click="CameraQr_Click"/>
                                </local:FlowPanel>
                                <StackPanel x:Name="ReceiveConfirmArea" Visibility="Collapsed" Spacing="16">
                                    <ListView x:Name="ReceivePreview" MaxHeight="200" SelectionMode="Multiple" DisplayMemberPath="Name"/>
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="ConfirmTransfer_Click" HorizontalAlignment="Left"><TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding ImportSelectedSubscriptions, Source={StaticResource UiText}}"/></Button>
                                </StackPanel>
                            </StackPanel></Expander>
                            <Expander x:Name="SendSection" Header="{Binding SendToPhoneLabel, Source={StaticResource UiText}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="16">
                                <local:ResponsiveGrid ColumnSpacing="16" RowSpacing="16" MinColumnWidth="240">
                                    <ComboBox x:Name="LanAddress" local:ResponsiveGrid.Weight="1" Header="{Binding ThisDeviceSLANAddress, Source={StaticResource UiText}}"/>
                                    <Button local:ResponsiveGrid.Weight="0" Content="{Binding RefreshAddresses, Source={StaticResource UiText}}" Click="RefreshAddresses_Click" VerticalAlignment="Bottom"/>
                                </local:ResponsiveGrid>
                                <TextBlock Text="{Binding ToSendSelectSubscriptionsInYourLibrary, Source={StaticResource UiText}}" Style="{StaticResource CaptionText}"/>
                                <Image x:Name="ShareQr" Width="280" Height="280" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <TextBlock x:Name="ShareCode" Visibility="Collapsed" Style="{StaticResource SubtitleText}"/>
                                <TextBox x:Name="ShareLink" IsReadOnly="True" TextWrapping="Wrap" Header="{Binding OneTimeEncryptedLink, Source={StaticResource UiText}}"/>
                                <TextBlock x:Name="ShareStatus" Text="{Binding NotSharing, Source={StaticResource UiText}}" Style="{StaticResource SecondaryText}"/>
                                <local:FlowPanel>
                                    <Button Content="{Binding CopyLink, Source={StaticResource UiText}}" Click="CopyShareLink_Click"/>
                                    <Button Content="{Binding StopSharing, Source={StaticResource UiText}}" Click="StopShare_Click"/>
                                </local:FlowPanel>
                            </StackPanel></Expander>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>

            <ProgressBar x:Name="BusyBar" Grid.Row="2" VerticalAlignment="Top" Margin="32,0" MaxWidth="960" IsIndeterminate="True" Visibility="Collapsed"/>

            <!-- Status messages float above the content so they never shift the layout. Hidden by opacity, not
                 visibility, to keep the polite live region in the accessibility tree. -->
            <Border x:Name="MessageBar" Grid.Row="2" Margin="32,0,32,16" Padding="16,12" MaxWidth="960" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" CornerRadius="12" Opacity="0" IsHitTestVisible="False" Background="{ThemeResource WeaveCardBrush}" BorderBrush="{ThemeResource WeaveLightEdgeBrush}" BorderThickness="1">
                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.2"/></Border.OpacityTransition>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Grid>
</Grid>
</Window>

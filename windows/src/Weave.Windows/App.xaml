                        <LinearGradientBrush x:Key="WeaveChartLineBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#6E81BD" Offset="0"/><GradientStop Color="#9F8FC2" Offset="1"/></LinearGradientBrush>
                        <SolidColorBrush x:Key="WeaveChartDotBrush" Color="#9F8FC2"/>

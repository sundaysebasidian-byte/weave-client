                        <LinearGradientBrush x:Key="WeaveActionPressedBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#232C50" Offset="0"/><GradientStop Color="#1B2240" Offset="1"/></LinearGradientBrush>

<Application
    x:Class="Weave.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Weave.Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                <!-- Appearance tokens. MainWindow.ApplyAppearance rewrites these brushes in place for the chosen theme and mode,
                     so every key must exist in both dictionaries with the same brush type. The values below are the default
                     theme (Impression, Sunrise) and only matter for the first frames before the saved choice is applied. -->
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="WeaveCanvasBrush" Color="#F3EDE3"/>

            <local:UiText x:Key="UiText" />

            <!-- Type: Segoe UI Variable for Latin and figures, Microsoft YaHei UI for body Chinese, DengXian Light for large Chinese.
                 YaHei only has Regular and Bold, so hierarchy comes from size, colour and spacing, not from weight. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text,Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="WeaveDisplayFont">Segoe UI Variable Display,DengXian Light,Microsoft YaHei UI Light</FontFamily>
            <FontFamily x:Key="WeaveMicroFont">Segoe UI Variable Small,Segoe UI Variable Text,Microsoft YaHei UI</FontFamily>

            <!-- Spacing 4 / 8 / 12 / 16 / 24 / 32. Radii: control 10, row 15, tile 22. -->
            <x:Double x:Key="SpaceXS">4</x:Double>
            <x:Double x:Key="SpaceS">8</x:Double>
            <x:Double x:Key="SpaceM">12</x:Double>
            <x:Double x:Key="SpaceL">16</x:Double>
            <x:Double x:Key="SpaceXL">24</x:Double>
            <x:Double x:Key="SpaceXXL">32</x:Double>
            <CornerRadius x:Key="WeaveControlRadius">10</CornerRadius>
            <CornerRadius x:Key="WeaveRowRadius">15</CornerRadius>
            <CornerRadius x:Key="WeaveTileRadius">24</CornerRadius>
            <CornerRadius x:Key="WeaveTileInnerRadius">23</CornerRadius>
            <Thickness x:Key="WeaveCardPadding">24</Thickness>

            <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{ThemeResource WeaveInkBrush}"/></Style>
            <Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="16"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{ThemeResource WeaveMutedBrush}"/></Style>
            <Style x:Key="SecondaryText" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="20"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{ThemeResource WeaveMutedBrush}"/></Style>
            <Style x:Key="BodyStrongText" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{ThemeResource WeaveInkBrush}"/></Style>
            <Style x:Key="MicroText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource WeaveMicroFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="CharacterSpacing" Value="140"/><Setter Property="Foreground" Value="{ThemeResource WeaveMutedBrush}"/></Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource MicroText}"/>
            <Style x:Key="SubtitleText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource WeaveDisplayFont}"/><Setter Property="FontSize" Value="20"/><Setter Property="LineHeight" Value="28"/><Setter Property="FontWeight" Value="Light"/><Setter Property="Foreground" Value="{ThemeResource WeaveInkBrush}"/></Style>
            <Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource WeaveDisplayFont}"/><Setter Property="FontSize" Value="28"/><Setter Property="LineHeight" Value="36"/><Setter Property="FontWeight" Value="Light"/><Setter Property="CharacterSpacing" Value="-10"/><Setter Property="Foreground" Value="{ThemeResource WeaveInkBrush}"/></Style>
            <!-- Figures: light, tabular, so live numbers never change width. -->
            <Style x:Key="NumberText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource WeaveDisplayFont}"/><Setter Property="FontWeight" Value="Light"/><Setter Property="CharacterSpacing" Value="-15"/><Setter Property="Foreground" Value="{ThemeResource WeaveInkBrush}"/></Style>
            <Style x:Key="UnitText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource WeaveMutedBrush}"/></Style>
            <!-- No Foreground: lets navigation labels inherit the colour of their state-aware parent. -->
            <Style x:Key="ButtonLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/></Style>
            <Style x:Key="NavLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextAlignment" Value="Center"/></Style>

            <!-- BasedOn keeps the themed WinUI templates; without it these implicit styles would replace them and bypass the
                 accent overrides above (the toggle fell back to the Windows accent colour). -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="CornerRadius" Value="{StaticResource WeaveControlRadius}"/><Setter Property="Padding" Value="16,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="14"/></Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="CornerRadius" Value="{StaticResource WeaveControlRadius}"/><Setter Property="MinHeight" Value="34"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="CornerRadius" Value="{StaticResource WeaveControlRadius}"/><Setter Property="MinHeight" Value="34"/><Setter Property="BorderBrush" Value="{ThemeResource WeaveRimBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}"><Setter Property="MinWidth" Value="0"/><Setter Property="OnContent" Value=""/><Setter Property="OffContent" Value=""/></Style>

            <!-- Round, quiet icon button: transparent at rest, ink wash on hover. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="34"/><Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="17"/><Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{ThemeResource WeaveMutedBrush}"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource WeaveSubtleFillBrush}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource WeaveSubtlePressedBrush}"/><Setter Target="Presenter.Foreground" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="CornerRadius" Value="14"/>
                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><FontIcon Glyph="{Binding}" FontSize="14"/></DataTemplate></Setter.Value></Setter>
            </Style>
            <!-- Secondary action beside the primary pill. -->
            <Style x:Key="QuietPillButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="16"/><Setter Property="MinHeight" Value="52"/><Setter Property="MinWidth" Value="52"/><Setter Property="Padding" Value="22,0"/>
                <Setter Property="Foreground" Value="{ThemeResource WeaveInkBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{ThemeResource WeaveSubtleFillBrush}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource WeaveSubtlePressedBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource WeaveSubtlePressedBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="16"/><Setter Property="MinHeight" Value="52"/><Setter Property="MinWidth" Value="168"/><Setter Property="Padding" Value="24,0"/><Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="SmallPillButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="12"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="18,0"/><Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="SegmentTrack" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WeaveHairBrush}"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="3"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- Segmented control: a horizontal single-select list; every segment is as wide as its own label. -->
            <Style x:Key="SegmentedItem" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="28"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" CornerRadius="8" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource WeaveSelectedBrush}"/><Setter Target="Label.Foreground" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource WeaveSelectedBrush}"/><Setter Target="Label.Foreground" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource WeaveSelectedBrush}"/><Setter Target="Label.Foreground" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Label.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{ThemeResource WeaveMutedBrush}" FontSize="12" Padding="14,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SegmentedList" TargetType="ListView">
                <Setter Property="SelectionMode" Value="Single"/><Setter Property="IsItemClickEnabled" Value="False"/><Setter Property="Padding" Value="0"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedItem}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled"/><Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
                <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
            </Style>

            <!-- Tile: one translucent fill, a bright inner edge and a faint outer line. Static layers only, no per-tile blur. -->
            <Style x:Key="Tile" TargetType="ContentControl">
                <Setter Property="Background" Value="{ThemeResource WeaveTileBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource WeaveTileRadius}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="-1" CornerRadius="25" BorderBrush="{ThemeResource WeaveTileOuterBrush}" BorderThickness="1" IsHitTestVisible="False"/>
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{ThemeResource WeaveTileStrokeBrush}" BorderThickness="1" IsHitTestVisible="False"/>
                        <!-- Glass sheen: light gathers along the top edge and fades within the upper half. -->
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource WeaveTileSheenBrush}" IsHitTestVisible="False"/>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="GlassCard" TargetType="ContentControl" BasedOn="{StaticResource Tile}">
                <Setter Property="Padding" Value="{StaticResource WeaveCardPadding}"/>
                <Setter Property="CornerRadius" Value="18"/>
            </Style>
            <Style x:Key="IconTile" TargetType="Border">
                <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="{ThemeResource WeaveSubtleFillBrush}"/>
            </Style>

            <!-- Sidebar entry: icon above a short label. Selection, hover and indicator are visual states. -->
            <Style x:Key="WeaveNavItem" TargetType="RadioButton">
                <Setter Property="GroupName" Value="WeaveNavigation"/>
                <Setter Property="Width" Value="56"/><Setter Property="Height" Value="58"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{ThemeResource WeaveMutedBrush}"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters>
                                    <Setter Target="Surface.Background" Value="{ThemeResource WeaveSubtleFillBrush}"/>
                                    <Setter Target="Presenter.Foreground" Value="{ThemeResource WeaveInkBrush}"/>
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters>
                                    <Setter Target="Surface.Background" Value="{ThemeResource WeaveSubtlePressedBrush}"/>
                                    <Setter Target="Presenter.Foreground" Value="{ThemeResource WeaveInkBrush}"/>
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                                <VisualState x:Name="Checked"><VisualState.Setters>
                                    <Setter Target="Surface.Background" Value="{ThemeResource WeaveTileBrush}"/>
                                    <Setter Target="Surface.BorderBrush" Value="{ThemeResource WeaveTileStrokeBrush}"/>
                                    <Setter Target="Indicator.Opacity" Value="1"/>
                                    <Setter Target="Presenter.Foreground" Value="{ThemeResource WeaveInkBrush}"/>
                                </VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Surface" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"/>
                        <!-- OpacityTransition can dereference a missing composition object before the first frame. -->
                        <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{ThemeResource WeaveSunBrush}" Opacity="0"/>
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

            <!-- Rows in lists. Hover washes the row, selection fills it and lights a sun-coloured bar. Focus uses the system ring. -->
            <Style x:Key="WeaveListRow" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="MinHeight" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="CornerRadius" Value="12"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSubtleFillBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSubtlePressedBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSelectedBrush}"/><Setter Target="Bar.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSelectedBrush}"/><Setter Target="Bar.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSelectedBrush}"/><Setter Target="Bar.Opacity" Value="1"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Fill" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent"/>
                        <Rectangle x:Name="Bar" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,13" HorizontalAlignment="Left" Fill="{ThemeResource WeaveSunBrush}" Opacity="0"/>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <!-- Cells in a grid of choices (quick exit list, theme gallery). A hairline frame; selection fills it. -->
            <Style x:Key="WeaveCell" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="CornerRadius" Value="{StaticResource WeaveRowRadius}"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSubtleFillBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSubtlePressedBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSelectedBrush}"/><Setter Target="Fill.BorderBrush" Value="{ThemeResource WeaveTileStrokeBrush}"/><Setter Target="Bar.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSelectedBrush}"/><Setter Target="Fill.BorderBrush" Value="{ThemeResource WeaveTileStrokeBrush}"/><Setter Target="Bar.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource WeaveSelectedBrush}"/><Setter Target="Fill.BorderBrush" Value="{ThemeResource WeaveTileStrokeBrush}"/><Setter Target="Bar.Opacity" Value="1"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Fill" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent" BorderBrush="{ThemeResource WeaveHairBrush}" BorderThickness="1"/>
                        <Rectangle x:Name="Bar" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,16" HorizontalAlignment="Left" Fill="{ThemeResource WeaveSunBrush}" Opacity="0"/>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            
            <!-- Filter pill in a horizontal list: quiet at rest, filled with ink when chosen. -->
            <Style x:Key="WeaveChipItem" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Pill" CornerRadius="15" Height="30" Padding="13,0" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Pill.Background" Value="{ThemeResource WeaveSubtleFillBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Pill.Background" Value="{ThemeResource WeaveSubtlePressedBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="Pill.Background" Value="{ThemeResource WeaveInkBrush}"/><Setter Target="Label.Foreground" Value="{ThemeResource WeaveCanvasBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="Pill.Background" Value="{ThemeResource WeaveInkBrush}"/><Setter Target="Label.Foreground" Value="{ThemeResource WeaveCanvasBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="Pill.Background" Value="{ThemeResource WeaveInkBrush}"/><Setter Target="Label.Foreground" Value="{ThemeResource WeaveCanvasBrush}"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{ThemeResource WeaveMutedBrush}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="ChipBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WeaveHairBrush}"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="12,4"/>
            </Style>
            <!-- Theme gallery cell: no frame, the chosen preview gets an ink outline. -->
            <Style x:Key="WeaveGalleryCell" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,16,14"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Ring.BorderBrush" Value="{ThemeResource WeaveFaintBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Ring.BorderBrush" Value="{ThemeResource WeaveMutedBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="Ring.BorderBrush" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="Ring.BorderBrush" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="Ring.BorderBrush" Value="{ThemeResource WeaveInkBrush}"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Ring" Margin="-4" CornerRadius="20" BorderBrush="Transparent" BorderThickness="1.5" IsHitTestVisible="False"/>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

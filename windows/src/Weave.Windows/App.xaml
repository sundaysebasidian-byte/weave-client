                        <SolidColorBrush x:Key="WeaveDangerBrush" Color="#C42B1C"/>
                        <SolidColorBrush x:Key="WeaveActionTextBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="WeaveAccentFillBrush" Color="#2F3A64"/>

<UserControl
    x:Class="Weave.Windows.Sparkline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="84" Height="18" IsTabStop="False" IsHitTestVisible="False">
    <Polyline x:Name="Line" Stroke="{ThemeResource WeaveMutedBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8"/>
</UserControl>

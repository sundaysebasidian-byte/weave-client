+package dns
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"encoding/binary"
+	"errors"
+	"io"
+	"math/big"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/ca"
+
+	"github.com/metacubex/quic-go"
+	"github.com/metacubex/tls"
+	D "github.com/miekg/dns"
+)
+
+type fixtureDNS struct {
+	address string
+	error   error
+}
+
+func (f fixtureDNS) Address() string  { return f.address }
+func (f fixtureDNS) ResetConnection() {}
+func (f fixtureDNS) ExchangeContext(_ context.Context, question *D.Msg) (*D.Msg, error) {
+	if f.error != nil {
+		return nil, f.error
+	}
+	reply := new(D.Msg).SetReply(question)
+	reply.Answer = []D.RR{&D.A{
+		Hdr: D.RR_Header{Name: question.Question[0].Name, Rrtype: D.TypeA, Class: D.ClassINET, Ttl: 60},
+		A:   net.IPv4(192, 0, 2, 3),
+	}}
+	return reply, nil
+}
+
+func TestWeaveProbePathReportsActualFallback(t *testing.T) {
+	r := &Resolver{
+		main:              []dnsClient{fixtureDNS{address: "primary", error: errors.New("primary offline")}},
+		fallback:          []dnsClient{fixtureDNS{address: "fallback"}},
+		fallbackLazyQuery: true,
+	}
+	got := r.ProbeActivePath(context.Background(), false)
+	if !got.Answered || got.Selected != "fallback" || len(got.Attempts) != 2 ||
+		got.Attempts[0].Outcome != "failed" || got.Attempts[1].Outcome != "answered" {
+		t.Fatalf("wrong fallback path: %#v", got)
+	}
+}
+
+func TestWeaveProbeDoQUsesAuthenticatedExchange(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	local := net.IPv4(127, 0, 0, 1)
+	cert := &x509.Certificate{
+		SerialNumber: big.NewInt(1), NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
+		BasicConstraintsValid: true, IsCA: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature,
+		ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, IPAddresses: []net.IP{local},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, cert, cert, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ca.AddCertificate(string(der)); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(ca.ResetCertificate)
+	listener, err := quic.ListenAddr("127.0.0.1:0", &tls.Config{
+		Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}},
+		NextProtos:   []string{NextProtoDQ},
+	}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+	defer cancel()
+	finished := make(chan error, 1)
+	go func() {
+		conn, err := listener.Accept(ctx)
+		if err != nil {
+			finished <- err
+			return
+		}
+		stream, err := conn.AcceptStream(ctx)
+		if err == nil {
+			err = sendDoQResponse(stream)
+		}
+		finished <- err
+	}()
+	got := (&Resolver{}).ProbeQUIC(ctx, listener.Addr().String(), false)
+	if !got.Answered || got.Elapsed < 1 {
+		t.Fatalf("real DoQ query did not return valid data: %#v", got)
+	}
+	if err := <-finished; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func sendDoQResponse(stream *quic.Stream) error {
+	var size [2]byte
+	if _, err := io.ReadFull(stream, size[:]); err != nil {
+		return err
+	}
+	frame := make([]byte, binary.BigEndian.Uint16(size[:]))
+	if _, err := io.ReadFull(stream, frame); err != nil {
+		return err
+	}
+	var question D.Msg
+	if err := question.Unpack(frame); err != nil {
+		return err
+	}
+	if question.Id != 0 || len(question.Question) != 1 || question.Question[0].Name != "example.com." {
+		return errors.New("unexpected DoQ test question")
+	}
+	reply, err := (fixtureDNS{}).ExchangeContext(context.Background(), &question)
+	if err != nil {
+		return err
+	}
+	answer, err := reply.Pack()
+	if err != nil {
+		return err
+	}
+	binary.BigEndian.PutUint16(size[:], uint16(len(answer)))
+	if _, err := stream.Write(append(size[:], answer...)); err != nil {
+		return err
+	}
+	return stream.Close()
+}

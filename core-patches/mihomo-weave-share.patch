diff --git a/internal/weaveshare/policy.go b/internal/weaveshare/policy.go
new file mode 100644
index 0000000..606d7ee
--- /dev/null
+++ b/internal/weaveshare/policy.go
@@ -0,0 +1,272 @@
+package weaveshare
+
+import (
+	"context"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/metacubex/sing/common"
+	"github.com/metacubex/sing/common/network"
+	"golang.org/x/time/rate"
+)
+
+const userPrefix = "weavepeer-"
+
+type policy struct {
+	expiry         int64
+	bytesPerSecond int
+}
+
+func parse(user string) (policy, bool, error) {
+	if !strings.HasPrefix(user, userPrefix) {
+		return policy{}, false, nil
+	}
+	parts := strings.Split(strings.TrimPrefix(user, userPrefix), "-")
+	if len(parts) != 3 || len(parts[0]) != 32 {
+		return policy{}, true, errors.New("invalid sharing account")
+	}
+	if _, err := hex.DecodeString(parts[0]); err != nil {
+		return policy{}, true, errors.New("invalid sharing account")
+	}
+	expiry, expiryErr := strconv.ParseInt(parts[1], 10, 64)
+	bps, bpsErr := strconv.Atoi(parts[2])
+	if expiryErr != nil || expiry <= 0 || bpsErr != nil || bps < 1024 || bps > 20*1024*1024 {
+		return policy{}, true, errors.New("invalid sharing account")
+	}
+	return policy{expiry: expiry, bytesPerSecond: bps}, true, nil
+}
+
+func Authorized(user string) bool {
+	p, managed, err := parse(user)
+	if !managed {
+		return true
+	}
+	if err != nil || p.expired() {
+		return false
+	}
+	peers.Lock()
+	defer peers.Unlock()
+	return peers.revoked[user] == 0
+}
+
+// Every check uses the clock that advances while Android sleeps.
+func (p policy) expired() bool {
+	now, err := bootMillis()
+	return err != nil || p.expiry <= now || p.expiry-now > 3_600_000
+}
+
+func smaller[T ~int | ~int64](first, second T) T {
+	if first < second {
+		return first
+	}
+	return second
+}
+
+type peer struct {
+	policy
+	up, down *rate.Limiter
+	refs     int
+	ctx      context.Context
+	cancel   context.CancelFunc
+}
+
+var peers = struct {
+	sync.Mutex
+	items   map[string]*peer
+	revoked map[string]int64
+}{items: make(map[string]*peer), revoked: make(map[string]int64)}
+
+// Revoke also cancels relays that crossed authentication just before revocation.
+func Revoke(user string) error {
+	p, managed, err := parse(user)
+	if !managed || err != nil {
+		return errors.New("invalid sharing account")
+	}
+	now, clockErr := bootMillis()
+	if clockErr != nil {
+		return clockErr
+	}
+	if p.expiry <= now {
+		return nil
+	}
+	if p.expiry-now > 3_600_000 {
+		return errors.New("invalid sharing deadline")
+	}
+	peers.Lock()
+	defer peers.Unlock()
+	for name, expiry := range peers.revoked {
+		if expiry <= now {
+			delete(peers.revoked, name)
+		}
+	}
+	if len(peers.revoked) >= 256 && peers.revoked[user] == 0 {
+		return errors.New("too many unexpired revocations")
+	}
+	peers.revoked[user] = p.expiry
+	if state := peers.items[user]; state != nil {
+		state.cancel()
+		delete(peers.items, user)
+	}
+	return nil
+}
+
+// May return a nil guard for an ordinary connection. Managed accounts fail closed.
+func Begin(user string) (*Guard, error) {
+	p, managed, err := parse(user)
+	if !managed || err != nil {
+		return nil, err
+	}
+	if p.expired() {
+		return nil, errors.New("sharing account expired")
+	}
+	peers.Lock()
+	defer peers.Unlock()
+	if peers.revoked[user] != 0 {
+		return nil, errors.New("sharing account revoked")
+	}
+	for name, peer := range peers.items {
+		if peer.refs == 0 && peer.expired() {
+			delete(peers.items, name)
+			peer.cancel()
+		}
+	}
+	state := peers.items[user]
+	if state == nil {
+		if len(peers.items) >= 64 {
+			return nil, errors.New("sharing quota reached")
+		}
+		burst := smaller(32768, p.bytesPerSecond/10)
+		if burst < 1024 {
+			burst = 1024
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		state = &peer{policy: p, up: rate.NewLimiter(rate.Limit(p.bytesPerSecond), burst), down: rate.NewLimiter(rate.Limit(p.bytesPerSecond), burst), ctx: ctx, cancel: cancel}
+		peers.items[user] = state
+	}
+	state.refs++
+	return &Guard{state: state}, nil
+}
+
+type Guard struct {
+	state *peer
+}
+
+func (g *Guard) End() {
+	if g == nil {
+		return
+	}
+	peers.Lock()
+	g.state.refs--
+	peers.Unlock()
+}
+
+func (g *Guard) WriteUpload(ctx context.Context, writer io.Writer, data []byte) (int, error) {
+	if g == nil || len(data) == 0 {
+		return writer.Write(data)
+	}
+	now, err := bootMillis()
+	if err != nil || g.state.expiry <= now {
+		return 0, errors.New("sharing account expired")
+	}
+	handshake, cancel := context.WithTimeout(ctx, time.Duration(g.state.expiry-now)*time.Millisecond)
+	defer cancel()
+	defer context.AfterFunc(g.state.ctx, cancel)()
+	return g.writeUpload(handshake, writer, data)
+}
+
+// Established relays already carry the session's expiry and revocation context.
+func (g *Guard) writeUpload(ctx context.Context, writer io.Writer, data []byte) (int, error) {
+	written := 0
+	for len(data) > 0 {
+		part := smaller(len(data), g.state.up.Burst())
+		if err := g.wait(ctx, g.state.up, part); err != nil {
+			return written, err
+		}
+		n, err := writer.Write(data[:part])
+		written += n
+		if err != nil {
+			return written, err
+		}
+		if n < part {
+			return written, io.ErrShortWrite
+		}
+		data = data[n:]
+	}
+	return written, nil
+}
+
+func (g *Guard) wait(ctx context.Context, limiter *rate.Limiter, n int) error {
+	for n > 0 {
+		now, err := bootMillis()
+		if err != nil || g.state.expiry <= now {
+			return errors.New("sharing account expired")
+		}
+		part := smaller(n, limiter.Burst())
+		err = limiter.WaitN(ctx, part)
+		if err != nil {
+			return err
+		}
+		n -= part
+	}
+	if g.state.expired() || g.state.ctx.Err() != nil {
+		return errors.New("sharing account expired")
+	}
+	return nil
+}
+
+func (g *Guard) Wrap(conn net.Conn) net.Conn {
+	if g == nil {
+		return conn
+	}
+	now, err := bootMillis()
+	if err != nil || g.state.expiry <= now {
+		_ = conn.Close()
+		return conn
+	}
+	ctx, done := context.WithTimeout(g.state.ctx, time.Duration(g.state.expiry-now)*time.Millisecond)
+	context.AfterFunc(ctx, func() { _ = conn.Close() })
+	return &limitedConn{Conn: conn, ctx: ctx, done: done, guard: g}
+}
+
+type limitedConn struct {
+	net.Conn
+	ctx   context.Context
+	done  context.CancelFunc
+	guard *Guard
+}
+
+func (c *limitedConn) Close() error {
+	c.done()
+	return c.Conn.Close()
+}
+
+func (c *limitedConn) CloseWrite() error {
+	if writer, ok := common.Cast[network.WriteCloser](c.Conn); ok {
+		return writer.CloseWrite()
+	}
+	return c.Close()
+}
+
+func (c *limitedConn) Read(p []byte) (int, error) {
+	if c.guard.state.expired() {
+		return 0, errors.New("sharing account expired")
+	}
+	n, err := c.Conn.Read(p[:smaller(len(p), c.guard.state.down.Burst())])
+	if n == 0 {
+		return n, err
+	}
+	if waitErr := c.guard.wait(c.ctx, c.guard.state.down, n); waitErr != nil {
+		return 0, waitErr
+	}
+	return n, err
+}
+
+func (c *limitedConn) Write(p []byte) (int, error) {
+	return c.guard.writeUpload(c.ctx, c.Conn, p)
+}

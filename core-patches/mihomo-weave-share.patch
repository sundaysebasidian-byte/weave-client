+++ b/listener/weave_trusted_test.go
@@ -0,0 +1,63 @@
+package listener
+
+import (
+	"errors"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type trustedTestListener struct {
+	C.InboundListener
+	active bool
+	busy   bool
+}
+
+func (l *trustedTestListener) Listen(C.Tunnel) error {
+	l.active = true
+	if l.busy {
+		return errors.New("fixture bind failure")
+	}
+	return nil
+}
+
+func (l *trustedTestListener) Close() error {
+	l.active = false
+	return nil
+}
+
+func TestTrustedSharingSuspendsAndRestoresOnlyItsOwnListeners(t *testing.T) {
+	inboundBefore, savedBefore := inboundListeners, suspendedTrusted
+	defer func() {
+		StopTrustedSharing()
+		inboundListeners, suspendedTrusted = inboundBefore, savedBefore
+	}()
+	one := &trustedTestListener{active: true}
+	two := &trustedTestListener{active: true}
+	unrelated := &trustedTestListener{active: true}
+	inboundListeners = map[string]C.InboundListener{
+		"weave-share-trusted-v4": one,
+		"weave-share-trusted-v6": two,
+		"private":                unrelated,
+	}
+	suspendedTrusted = make(map[string]C.InboundListener)
+
+	StopTrustedSharing()
+	if one.active || two.active || !unrelated.active {
+		t.Fatal("suspend must only close the trusted listeners")
+	}
+	two.busy = true
+	if ResumeTrustedSharing(nil) || one.active || two.active || !unrelated.active {
+		t.Fatal("any bind failure must leave the complete trusted set closed")
+	}
+	two.busy = false
+	if !ResumeTrustedSharing(nil) || !one.active || !two.active || !unrelated.active {
+		t.Fatal("the exact saved set must reopen after binding is available")
+	}
+
+	StopTrustedSharing()
+	PatchInboundListeners(nil, nil, true)
+	if ResumeTrustedSharing(nil) || one.active || two.active {
+		t.Fatal("config replacement must discard paused listeners")
+	}
+}

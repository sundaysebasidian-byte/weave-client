+package weaveshare
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"golang.org/x/time/rate"
+)
+
+func BenchmarkRelayRateAdmission(b *testing.B) {
+	for _, name := range []string{"per-buffer-context", "session-context"} {
+		b.Run(name, func(b *testing.B) {
+			lease, end := context.WithTimeout(context.Background(), time.Hour)
+			defer end()
+			quota := rate.NewLimiter(rate.Inf, 32768)
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				if name == "per-buffer-context" {
+					frame, cancel := context.WithTimeout(lease, time.Minute)
+					detach := context.AfterFunc(lease, cancel)
+					if err := quota.WaitN(frame, 32768); err != nil {
+						b.Fatal(err)
+					}
+					detach()
+					cancel()
+				} else if err := quota.WaitN(lease, 32768); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
+}

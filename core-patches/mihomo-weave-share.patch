+package weaveshare
+
+import "golang.org/x/sys/unix"
+
+func bootMillis() (int64, error) {
+	var now unix.Timespec
+	err := unix.ClockGettime(unix.CLOCK_BOOTTIME, &now)
+	return int64(now.Sec)*1000 + int64(now.Nsec)/1_000_000, err
+}

diff --git a/dns/weave_adaptive.go b/dns/weave_adaptive.go
new file mode 100644
index 0000000..8572310
--- /dev/null
+++ b/dns/weave_adaptive.go
@@ -0,0 +1,108 @@
+package dns
+
+import (
+	"context"
+	"sort"
+	"sync"
+	"time"
+)
+
+const adaptiveHedge = 40 * time.Millisecond
+const adaptiveLifetime = 90 * time.Second
+
+type resolverScore struct {
+	latency  time.Duration
+	failures int
+	last     time.Time
+}
+
+// The score belongs to a resolver instance. It stores no DNS names or answers.
+type adaptiveDNS struct {
+	mu         sync.Mutex
+	scores     map[string]resolverScore
+	queries    uint64
+	generation uint64
+}
+
+func adaptiveKey(client dnsClient) string {
+	return probeTransport(client) + "|" + client.Address()
+}
+
+func (d *adaptiveDNS) plan(clients []dnsClient) ([]dnsClient, int, uint64) {
+	if d == nil || len(clients) < 3 {
+		return clients, len(clients), 0
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.queries++
+	if d.queries <= 3 || d.queries%8 == 0 || len(d.scores) == 0 {
+		return clients, len(clients), d.generation
+	}
+	now := time.Now()
+	scored := make([]struct {
+		client dnsClient
+		score  time.Duration
+	}, 0, len(clients))
+	for _, c := range clients {
+		history := d.scores[adaptiveKey(c)]
+		cost := 750 * time.Millisecond
+		if now.Sub(history.last) <= adaptiveLifetime {
+			if history.latency > 0 {
+				cost = history.latency
+			}
+			cost += time.Duration(history.failures) * 500 * time.Millisecond
+		}
+		scored = append(scored, struct {
+			client dnsClient
+			score  time.Duration
+		}{c, cost})
+	}
+	sort.SliceStable(scored, func(i, j int) bool { return scored[i].score < scored[j].score })
+	ordered := make([]dnsClient, len(scored))
+	for i, entry := range scored {
+		ordered[i] = entry.client
+	}
+	return ordered, 2, d.generation
+}
+
+func (d *adaptiveDNS) observe(ctx context.Context, c dnsClient, duration time.Duration, succeeded bool, generation uint64) {
+	if d == nil || !succeeded && ctx.Err() != nil {
+		return
+	}
+	key := adaptiveKey(c)
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if generation != d.generation {
+		return
+	}
+	s := d.scores[key]
+	now := time.Now()
+	if now.Sub(s.last) > adaptiveLifetime {
+		s = resolverScore{}
+	}
+	if succeeded {
+		if s.latency == 0 {
+			s.latency = duration
+		} else {
+			s.latency = (7*s.latency + duration) / 8
+		}
+		if s.failures > 0 {
+			s.failures--
+		}
+	} else if s.failures < 4 {
+		s.failures++
+	}
+	s.last = now
+	d.scores[key] = s
+}
+
+func (d *adaptiveDNS) reset() {
+	if d == nil {
+		return
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.scores = make(map[string]resolverScore)
+	d.queries = 0
+	d.generation++
+}
diff --git a/dns/weave_adaptive_test.go b/dns/weave_adaptive_test.go
new file mode 100644
index 0000000..b924a1b
--- /dev/null
+++ b/dns/weave_adaptive_test.go
@@ -0,0 +1,87 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	D "github.com/miekg/dns"
+)
+
+type adaptiveFixture struct {
+	fixtureDNS
+	wait  time.Duration
+	sends *atomic.Int64
+}
+
+func (f adaptiveFixture) ExchangeContext(ctx context.Context, q *D.Msg) (*D.Msg, error) {
+	f.sends.Add(1)
+	if f.wait > 0 {
+		timer := time.NewTimer(f.wait)
+		defer timer.Stop()
+		select {
+		case <-timer.C:
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	return f.fixtureDNS.ExchangeContext(ctx, q)
+}
+
+func warmAdaptiveFixtures(b testing.TB, failFirst bool) ([]dnsClient, *adaptiveDNS, *atomic.Int64) {
+	b.Helper()
+	writes := &atomic.Int64{}
+	ready := &adaptiveDNS{scores: make(map[string]resolverScore), queries: 4}
+	var clients []dnsClient
+	for i, name := range []string{"A", "B", "C", "D", "E", "F"} {
+		fixture := adaptiveFixture{fixtureDNS: fixtureDNS{address: name}, wait: time.Millisecond, sends: writes}
+		if failFirst && i < 2 {
+			fixture.fixtureDNS.error = errors.New("primary offline")
+		}
+		clients = append(clients, fixture)
+		ready.observe(context.Background(), fixture, time.Duration(i+1)*time.Millisecond, true, 0)
+	}
+	return clients, ready, writes
+}
+
+func TestWeaveAdaptivePreservesBackupWhenBothPrimariesFail(t *testing.T) {
+	clients, quality, writes := warmAdaptiveFixtures(t, true)
+	result, _, err := batchExchangeAdaptive(context.Background(), clients, weaveProbeQuestion(false), quality)
+	if result == nil || err != nil || writes.Load() < 3 {
+		t.Fatalf("No working fallback after unavailable primaries: %v sends=%d", err, writes.Load())
+	}
+}
+
+func TestWeaveAdaptiveUsesOnlyTwoOnHealthyWarmQuery(t *testing.T) {
+	clients, quality, writes := warmAdaptiveFixtures(t, false)
+	result, _, err := batchExchangeAdaptive(context.Background(), clients, weaveProbeQuestion(false), quality)
+	if result == nil || err != nil || writes.Load() != 2 {
+		t.Fatalf("Expected exactly two requests: %v sends=%d", err, writes.Load())
+	}
+	quality.reset()
+	_, _, err = batchExchangeAdaptive(context.Background(), clients, weaveProbeQuestion(false), quality)
+	if err != nil || writes.Load() != 8 {
+		t.Fatalf("Reset should relearn all six upstreams: %v sends=%d", err, writes.Load())
+	}
+}
+
+func BenchmarkWeaveAdaptiveRequests(b *testing.B) {
+	for _, name := range []string{"all", "adaptive"} {
+		b.Run(name, func(b *testing.B) {
+			clients, quality, writes := warmAdaptiveFixtures(b, false)
+			if name == "all" {
+				quality = nil
+			}
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				if result, _, err := batchExchangeAdaptive(context.Background(), clients, weaveProbeQuestion(false), quality); result == nil || err != nil {
+					b.Fatal(err)
+				}
+			}
+			b.ReportMetric(float64(writes.Load())/float64(b.N), "queries/op")
+		})
+	}
+}
diff --git a/dns/weave_probe.go b/dns/weave_probe.go
new file mode 100644
index 0000000..948e82f
--- /dev/null
+++ b/dns/weave_probe.go
@@ -0,0 +1,153 @@
+package dns
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"time"
+
+	D "github.com/miekg/dns"
+)
+
+type probeTraceKey struct{}
+
+type ProbeAttempt struct {
+	Endpoint  string `json:"endpoint"`
+	Transport string `json:"transport"`
+	Elapsed   int64  `json:"elapsedMs,omitempty"`
+	Outcome   string `json:"outcome"`
+	Selected  bool   `json:"selected,omitempty"`
+}
+
+type ProbePath struct {
+	Elapsed  int64          `json:"elapsedMs"`
+	Answered bool           `json:"answered"`
+	Selected string         `json:"selected,omitempty"`
+	Attempts []ProbeAttempt `json:"attempts"`
+}
+
+type probeAttemptState struct {
+	ProbeAttempt
+	answer *D.Msg
+}
+
+type probeTrace struct {
+	sync.Mutex
+	attempts []*probeAttemptState
+}
+
+func probeTransport(server dnsClient) string {
+	switch typed := server.(type) {
+	case *dnsOverQUIC:
+		return "DoQ"
+	case *dnsOverTLS:
+		return "DoT"
+	case *dnsOverHTTPS:
+		return "DoH"
+	case *client:
+		return typed.schema
+	case *systemClient:
+		return "System"
+	case *dhcpClient:
+		return "DHCP"
+	case clientWithDisableTypes:
+		return probeTransport(typed.dnsClient)
+	case clientWithEdns0Subnet:
+		return probeTransport(typed.dnsClient)
+	default:
+		return ""
+	}
+}
+
+func (t *probeTrace) exchange(ctx context.Context, client dnsClient, m *D.Msg) (*D.Msg, error) {
+	attempt := &probeAttemptState{ProbeAttempt: ProbeAttempt{Endpoint: client.Address(), Transport: probeTransport(client), Outcome: "pending"}}
+	t.Lock()
+	if len(t.attempts) < 16 {
+		t.attempts = append(t.attempts, attempt)
+	}
+	t.Unlock()
+	start := time.Now()
+	answer, err := client.ExchangeContext(ctx, m)
+	t.Lock()
+	attempt.Elapsed = maxProbeMillis(start)
+	attempt.Outcome = "no-address"
+	switch {
+	case err != nil:
+		attempt.Outcome = "failed"
+	case probeAnswered(answer, m):
+		attempt.Outcome = "answered"
+	}
+	attempt.answer = answer
+	t.Unlock()
+	return answer, err
+}
+
+// ProbeActivePath bypasses cache and singleflight so every reported upstream belongs to
+// this explicit query. The existing resolver policy, fallback and racing code choose the result.
+func (r *Resolver) ProbeActivePath(ctx context.Context, ipv6 bool) ProbePath {
+	trace := &probeTrace{}
+	start := time.Now()
+	q := weaveProbeQuestion(ipv6)
+	answer, err := r.ipExchange(context.WithValue(ctx, probeTraceKey{}, trace), q)
+	result := ProbePath{Elapsed: maxProbeMillis(start), Answered: err == nil && probeAnswered(answer, q)}
+	trace.Lock()
+	defer trace.Unlock()
+	result.Attempts = make([]ProbeAttempt, 0, len(trace.attempts))
+	for _, attempt := range trace.attempts {
+		row := attempt.ProbeAttempt
+		if answer != nil && attempt.answer == answer {
+			row.Selected = true
+			result.Selected = row.Endpoint
+		}
+		result.Attempts = append(result.Attempts, row)
+	}
+	return result
+}
+
+// ProbeQUIC sends the same known question over a fresh authenticated DoQ connection.
+func (r *Resolver) ProbeQUIC(ctx context.Context, address string, ipv6 bool) ProbePath {
+	start := time.Now()
+	client := newDoQ(address, r.defaultResolver, nil, nil, "")
+	defer client.Close()
+	q := weaveProbeQuestion(ipv6)
+	answer, err := client.ExchangeContext(ctx, q)
+	return ProbePath{Elapsed: maxProbeMillis(start), Answered: err == nil && probeAnswered(answer, q)}
+}
+
+func weaveProbeQuestion(ipv6 bool) *D.Msg {
+	queryType := D.TypeA
+	if ipv6 {
+		queryType = D.TypeAAAA
+	}
+	return new(D.Msg).SetQuestion("example.com.", queryType)
+}
+
+func probeAnswered(answer, question *D.Msg) bool {
+	if answer == nil || !answer.Response || answer.Truncated || answer.Id != question.Id ||
+		answer.Rcode != D.RcodeSuccess || len(answer.Question) != 1 || answer.Question[0] != question.Question[0] {
+		return false
+	}
+	for _, rr := range answer.Answer {
+		header := rr.Header()
+		if header.Class != D.ClassINET || !strings.EqualFold(header.Name, question.Question[0].Name) {
+			continue
+		}
+		switch record := rr.(type) {
+		case *D.A:
+			return question.Question[0].Qtype == D.TypeA && record.A.To4() != nil
+		case *D.AAAA:
+			return question.Question[0].Qtype == D.TypeAAAA && record.AAAA.To16() != nil && record.AAAA.To4() == nil
+		}
+	}
+	return false
+}
+
+func maxProbeMillis(start time.Time) int64 {
+	elapsed := time.Since(start).Milliseconds()
+	if elapsed < 1 {
+		return 1
+	}
+	return elapsed
+}
+
+func (r *Resolver) ResetAdaptiveQuality() { r.adaptive.reset() }

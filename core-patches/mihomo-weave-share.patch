+func StopTrustedSharing() {
+	inboundMux.Lock()
+	defer inboundMux.Unlock()
+	weaveshare.DisableTrusted()
+	for name, active := range inboundListeners {
+		if weaveshare.IsTrustedListener(name) {
+			_ = active.Close()
+			if suspendedTrusted == nil {
+				suspendedTrusted = make(map[string]C.InboundListener)
+			}
+			suspendedTrusted[name] = active
+			delete(inboundListeners, name)
+		}
+	}
+}
+
+// ResumeTrustedSharing reopens only the listeners saved by StopTrustedSharing.
+func ResumeTrustedSharing(tunnel C.Tunnel) bool {
+	inboundMux.Lock()
+	defer inboundMux.Unlock()
+	if len(suspendedTrusted) == 0 {
+		for name := range inboundListeners {
+			if weaveshare.IsTrustedListener(name) {
+				return true
+			}
+		}
+		return false
+	}
+	for _, paused := range suspendedTrusted {
+		if err := paused.Listen(tunnel); err != nil {
+			for _, instance := range suspendedTrusted {
+				_ = instance.Close()
+			}
+			return false
+		}
+	}
+	for name, instance := range suspendedTrusted {
+		inboundListeners[name] = instance
+	}
+	suspendedTrusted = nil
+	weaveshare.EnableTrusted()
+	return true
+}

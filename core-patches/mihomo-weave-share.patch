index 0000000..e0a944d
--- /dev/null
+++ b/hub/route/share_connections_test.go
@@ -0,0 +1,81 @@
+package route
+
+import (
+	"encoding/json"
+	"net/netip"
+	"testing"
+
+	"github.com/metacubex/mihomo/common/atomic"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/tunnel/statistic"
+
+	"github.com/gofrs/uuid/v5"
+)
+
+type shareFixtureTracker struct {
+	statistic.Tracker
+	data *statistic.TrackerInfo
+}
+
+func (t shareFixtureTracker) ID() string                   { return t.data.UUID.String() }
+func (t shareFixtureTracker) Info() *statistic.TrackerInfo { return t.data }
+
+func addShareFixture(b testing.TB, port uint16, user, ip string) {
+	b.Helper()
+	tracker := shareFixtureTracker{data: &statistic.TrackerInfo{
+		UUID: uuid.Must(uuid.NewV4()),
+		Metadata: &C.Metadata{
+			SrcIP: netip.MustParseAddr(ip), InPort: port, InUser: user,
+			Host: "must-never-be-present-in-a-share-snapshot.example",
+		},
+		UploadTotal: atomic.NewInt64(23), DownloadTotal: atomic.NewInt64(47), Chain: C.Chain{"test-exit"},
+	}}
+	statistic.DefaultManager.Join(tracker)
+	b.Cleanup(func() { statistic.DefaultManager.Leave(tracker) })
+}
+
+func TestSharedConnectionsExcludeUnrelatedMetadata(t *testing.T) {
+	addShareFixture(t, 7890, "authenticated", "192.168.3.7")
+	addShareFixture(t, 7891, "grant", "169.254.3.7")
+	addShareFixture(t, 7891, "grant", "8.8.8.8")
+	addShareFixture(t, 7890, "", "192.168.3.8")
+	addShareFixture(t, 7892, "unrelated", "192.168.3.9")
+	rows := sharedConnections(statistic.DefaultManager)
+	if len(rows) != 2 {
+		t.Fatalf("got %d shared connections, want 2", len(rows))
+	}
+	for _, row := range rows {
+		if row.Uploaded != 23 || row.Downloaded != 47 || len(row.Exits) != 1 {
+			t.Fatal("shared counters or exit lost")
+		}
+	}
+}
+
+func BenchmarkShareSnapshot(b *testing.B) {
+	for i := 0; i < 5000; i++ {
+		addShareFixture(b, 0, "", "10.0.0.1")
+	}
+	for i := 0; i < 20; i++ {
+		addShareFixture(b, 7890, "authenticated", "192.168.3.7")
+	}
+	b.Run("FullConnections", func(b *testing.B) {
+		b.ReportAllocs()
+		for i := 0; i < b.N; i++ {
+			result, err := json.Marshal(statistic.DefaultManager.Snapshot())
+			if err != nil {
+				b.Fatal(err)
+			}
+			b.ReportMetric(float64(len(result)), "payload-B")
+		}
+	})
+	b.Run("ShareConnections", func(b *testing.B) {
+		b.ReportAllocs()
+		for i := 0; i < b.N; i++ {
+			result, err := json.Marshal(map[string]any{"connections": sharedConnections(statistic.DefaultManager)})
+			if err != nil {
+				b.Fatal(err)
+			}
+			b.ReportMetric(float64(len(result)), "payload-B")
+		}
+	})
+}

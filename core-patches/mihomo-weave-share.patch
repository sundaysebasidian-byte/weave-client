+package weaveshare
+
+import (
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestTrustedRevocationDoesNotReopenOldRelays(t *testing.T) {
+	const name = "weave-share-trusted-grants-0"
+	DisableTrusted()
+	t.Cleanup(DisableTrusted)
+	server, peer := net.Pipe()
+	defer server.Close()
+	defer peer.Close()
+	if _, allowed := AttachTrusted(name, server); allowed {
+		t.Fatal("unknown Wi-Fi must fail closed")
+	}
+	EnableTrusted()
+	release, allowed := AttachTrusted(name, server)
+	if !allowed {
+		t.Fatal("the verified session was rejected")
+	}
+	defer release()
+	DisableTrusted()
+	EnableTrusted()
+	peer.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := peer.Read(make([]byte, 1)); !errors.Is(err, io.EOF) {
+		t.Fatalf("old relay was not closed on network loss: %v", err)
+	}
+}

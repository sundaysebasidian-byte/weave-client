new file mode 100644
index 0000000..648a3dc
--- /dev/null
+++ b/internal/weaveshare/trusted.go
@@ -0,0 +1,48 @@
+package weaveshare
+
+import (
+	"context"
+	"io"
+	"strings"
+	"sync"
+)
+
+const trustedPrefix = "weave-share-trusted-"
+
+var trusted struct {
+	sync.Mutex
+	ctx    context.Context
+	cancel context.CancelFunc
+}
+
+func IsTrustedListener(name string) bool { return strings.HasPrefix(name, trustedPrefix) }
+
+func EnableTrusted() {
+	trusted.Lock()
+	defer trusted.Unlock()
+	if trusted.ctx == nil {
+		trusted.ctx, trusted.cancel = context.WithCancel(context.Background())
+	}
+}
+
+func DisableTrusted() {
+	trusted.Lock()
+	defer trusted.Unlock()
+	if trusted.cancel != nil {
+		trusted.cancel()
+	}
+	trusted.ctx, trusted.cancel = nil, nil
+}
+
+// AttachTrusted pins an accepted relay to the lifecycle of this trusted Wi-Fi session.
+func AttachTrusted(name string, conn io.Closer) (release func() bool, allowed bool) {
+	if !IsTrustedListener(name) {
+		return nil, true
+	}
+	trusted.Lock()
+	defer trusted.Unlock()
+	if trusted.ctx == nil {
+		return nil, false
+	}
+	return context.AfterFunc(trusted.ctx, func() { _ = conn.Close() }), true
+}
